<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<div id="components-reconnect-modal"
     class="components-reconnect-status"
     data-state="connected"
     data-nosnippet
     aria-live="polite"
     aria-atomic="true">
    <span class="components-reconnect-dot" aria-hidden="true"></span>
    <span class="components-reconnect-label components-reconnect-connected-visible">흐름 연결됨</span>
    <span class="components-reconnect-label components-reconnect-first-attempt-visible">흐름 다시 잇는 중</span>
    <span class="components-reconnect-label components-reconnect-repeated-attempt-visible">
        흐름 다시 잇기 <span id="components-seconds-to-next-attempt"></span>초
    </span>
    <span class="components-reconnect-label components-reconnect-failed-visible">흐름 연결 실패</span>
    <span class="components-reconnect-label components-pause-visible">흐름 일시 중지</span>
    <span class="components-reconnect-label components-resume-failed-visible">흐름 복구 실패</span>
    <button id="components-reconnect-button" class="components-reconnect-action components-reconnect-failed-visible" type="button">
        흐름 다시 잇기
    </button>
    <button id="components-resume-button" class="components-reconnect-action components-pause-visible components-resume-failed-visible" type="button">
        흐름 재개
    </button>
</div>
