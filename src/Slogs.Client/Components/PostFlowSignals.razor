<div class="@Class" aria-label="로그 목록 정보">
    <span class="post-log-card__signal post-log-card__signal--primary">@(Post.IsDraft ? "게시전 로그" : "공개 로그")</span>
    @if (Post.Series.Count > 0)
    {
        <a class="post-log-card__signal"
           href="@($"/series/{Uri.EscapeDataString(Post.Series[0])}")">@GetSeriesSignalText()</a>
    }
    <span class="post-log-card__signal">@($"{Post.Tags.Count} 태그")</span>
    <span class="post-log-card__signal">@($"{Post.CommentCount} 대화 흔적")</span>
    <span class="post-log-card__signal">@($"{Post.LikeCount} 공감")</span>
</div>

@code {
    [Parameter, EditorRequired] public BlogPost Post { get; set; } = default!;

    [Parameter] public string Class { get; set; } = "post-log-card__signals";

    private string GetSeriesSignalText()
    {
        var first = Post.Series[0];
        return Post.Series.Count == 1
            ? $"로그 시리즈: {first}"
            : $"로그 시리즈: {first} +{Post.Series.Count - 1}";
    }
}
