<p class="@Class" aria-label="@AriaLabel">@FormatRecallPath(Post)</p>

@code {
    [Parameter, EditorRequired] public BlogPost Post { get; set; } = default!;

    [Parameter] public string Class { get; set; } = "post-log-card__recall-path";

    [Parameter] public string AriaLabel { get; set; } = "로그 회상 경로";

    private static string FormatRecallPath(BlogPost post)
        => $"회상 경로: {FormatUserName(post.Author)} -> {GetPrimaryClue(post)} -> {GetSeriesPath(post)} -> {GetConversationSignal(post)}";

    private static string FormatUserName(string author)
        => string.IsNullOrWhiteSpace(author) ? "슬로거" : $"@{author.Trim()}";

    private static string GetPrimaryClue(BlogPost post)
    {
        var tag = post.Tags.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        return string.IsNullOrWhiteSpace(tag) ? "단서 미지정" : $"#{tag}";
    }

    private static string GetSeriesPath(BlogPost post)
    {
        var series = post.Series.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        return string.IsNullOrWhiteSpace(series) ? "단일 로그" : $"시리즈 {series}";
    }

    private static string GetConversationSignal(BlogPost post)
        => $"{post.CommentCount:N0} 대화/{post.LikeCount:N0} 반응";
}
