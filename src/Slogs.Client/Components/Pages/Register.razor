@page "/register"
@inject SlogsAuthState AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>지식 로그 홈 만들기</PageTitle>
<SeoHead Title="지식 로그 홈 만들기 | slogs" Description="slogs에서 공개 지식 로그 홈을 시작합니다." NoIndex="true" />

<form class="grid max-w-2xl gap-4 rounded-2xl border border-slate-200 bg-white p-5"
      @onsubmit="SubmitRegister"
      @onsubmit:preventDefault>
    <div class="flex flex-wrap items-center gap-4">
        <div class="h-16 w-16 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
            @if (!string.IsNullOrWhiteSpace(profileImageUrl))
            {
                <img class="h-full w-full object-cover"
                     src="@profileImageUrl"
                     alt="@($"{GetPreviewDisplayName()} 홈 이미지")"
                     loading="lazy"
                     decoding="async" />
            }
            else
            {
                <div class="flex h-full w-full items-center justify-center bg-emerald-950 text-lg font-black text-white">@GetPreviewInitials()</div>
            }
        </div>
        <div class="min-w-0">
            <p class="text-xs font-bold text-slate-500">public knowledge-log home</p>
            <h1 class="mt-1 text-2xl font-black text-slate-900">지식 로그 홈 만들기</h1>
            <p class="mt-1 text-sm leading-6 text-slate-500">처음부터 슬로거 홈 &#64;주소, 홈 이미지, 홈 소개를 남겨 생각과 작업의 로그가 누구에게 이어지는지 보이게 합니다.</p>
        </div>
    </div>

    <label class="grid gap-1 text-sm font-semibold text-slate-700" for="register-user-name">
        슬로거 홈 &#64;주소
        <input id="register-user-name"
               name="userName"
               class="rounded-2xl border border-slate-300 px-3 py-2 text-sm"
               autocomplete="username"
               placeholder="예: dimohy"
               @bind="userName"
               @bind:event="oninput" />
    </label>

    <label class="grid gap-1 text-sm font-semibold text-slate-700" for="register-display-name">
        표시 이름
        <input id="register-display-name"
               name="displayName"
               class="rounded-2xl border border-slate-300 px-3 py-2 text-sm"
               autocomplete="name"
               placeholder="공개 홈에 보일 이름"
               @bind="displayName"
               @bind:event="oninput" />
    </label>

    <div class="grid gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
        <div>
            <p class="text-xs font-bold text-slate-500">첫 슬로거 홈 태그</p>
            <p class="mt-1 text-sm leading-6 text-slate-600">비워도 시작할 수 있고, 나중에 슬로거 홈 정체성에서 바꿀 수 있습니다.</p>
        </div>

        <label class="grid gap-1 text-sm font-semibold text-slate-700" for="register-profile-image-url">
            슬로거 홈 이미지 URL
            <input id="register-profile-image-url"
                   name="profileImageUrl"
                   class="rounded-2xl border border-slate-300 bg-white px-3 py-2 text-sm"
                   autocomplete="photo"
                   placeholder="https://... 또는 /uploads/..."
                   @bind="profileImageUrl"
                   @bind:event="oninput" />
        </label>

        <label class="grid gap-1 text-sm font-semibold text-slate-700" for="register-bio">
            홈 소개
            <textarea id="register-bio"
                      name="bio"
                      class="min-h-24 rounded-2xl border border-slate-300 bg-white px-3 py-2 text-sm"
                      maxlength="280"
                      placeholder="내가 남길 생각, 작업, 판단의 내용을 한 문장으로 적어 주세요."
                      @bind="profileBio"
                      @bind:event="oninput"></textarea>
        </label>
        <p class="text-right text-xs font-semibold text-slate-500">@($"{profileBio.Length}/280")</p>
    </div>

    <label class="grid gap-1 text-sm font-semibold text-slate-700" for="register-password">
        비밀번호
        <input id="register-password"
               name="password"
               class="rounded-2xl border border-slate-300 px-3 py-2 text-sm"
               type="password"
               autocomplete="new-password"
               @bind="password"
               @bind:event="oninput" />
    </label>

    <label class="grid gap-1 text-sm font-semibold text-slate-700" for="register-confirm-password">
        비밀번호 확인
        <input id="register-confirm-password"
               name="confirmPassword"
               class="rounded-2xl border border-slate-300 px-3 py-2 text-sm"
               type="password"
               autocomplete="new-password"
               @bind="confirmPassword"
               @bind:event="oninput" />
    </label>

    <button class="w-fit rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60"
            type="submit" disabled="@isSubmitting">@((isSubmitting) ? "홈 만드는 중..." : "지식 로그 홈 만들기")</button>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="text-sm text-red-700">@ErrorMessage</p>
    }

    <p class="text-sm text-slate-500">이미 슬로거 홈이 있다면 <a class="font-semibold underline" href="@GetLoginHref()">지식 로그로 돌아가기</a></p>
</form>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private string userName = string.Empty;
    private string displayName = string.Empty;
    private string profileImageUrl = string.Empty;
    private string profileBio = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string apiError = string.Empty;
    private bool isSubmitting;
    private string? SafeReturnUrl => TryNormalizeRelativeReturnUrl(ReturnUrl, out var safeUrl) ? safeUrl : null;
    private string ErrorMessage => !string.IsNullOrWhiteSpace(apiError)
        ? apiError
        : Error switch
    {
        "required" => "슬로거 홈 @주소와 비밀번호는 필수입니다.",
        "passwordLength" => "비밀번호는 4자 이상이어야 합니다.",
        "passwordMismatch" => "비밀번호가 일치하지 않습니다.",
        "displayNameLength" => "표시 이름은 30자 이하여야 합니다.",
        "profileImageUrlLength" => "슬로거 홈 이미지 URL은 500자 이하여야 합니다.",
        "profileImageUrlInvalid" => "슬로거 홈 이미지 URL은 http, https 또는 /uploads 경로여야 합니다.",
        "profileBioLength" => "홈 소개는 280자 이하여야 합니다.",
        "duplicate" => "이미 사용 중인 슬로거 홈 @주소입니다.",
        "registerFailed" => "지식 로그 홈을 만들지 못했습니다.",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        await AuthState.EnsureInitializedAsync();
        if (AuthState.CurrentUser is not null)
        {
            Navigation.NavigateTo(SafeReturnUrl ?? "/me");
        }
    }

    private async Task SubmitRegister()
    {
        apiError = string.Empty;
        if (string.IsNullOrWhiteSpace(userName) || string.IsNullOrWhiteSpace(password))
        {
            apiError = "슬로거 홈 @주소와 비밀번호는 필수입니다.";
            return;
        }

        if (password.Length < 4)
        {
            apiError = "비밀번호는 4자 이상이어야 합니다.";
            return;
        }

        if (!string.Equals(password, confirmPassword, StringComparison.Ordinal))
        {
            apiError = "비밀번호가 일치하지 않습니다.";
            return;
        }

        if (displayName.Length > 30)
        {
            apiError = "표시 이름은 30자 이하여야 합니다.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(profileImageUrl) && profileImageUrl.Trim().Length > 500)
        {
            apiError = "슬로거 홈 이미지 URL은 500자 이하여야 합니다.";
            return;
        }

        if (!IsValidProfileImageUrl(profileImageUrl))
        {
            apiError = "슬로거 홈 이미지 URL은 http, https 또는 /uploads 경로여야 합니다.";
            return;
        }

        if (profileBio.Trim().Length > 280)
        {
            apiError = "홈 소개는 280자 이하여야 합니다.";
            return;
        }

        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            var result = await JS.InvokeAsync<AuthApiResult>(
                "slogsAuthApi.register",
                new
                {
                    userName,
                    displayName,
                    password,
                    confirmPassword,
                    profileImageUrl,
                    bio = profileBio,
                    returnUrl = SafeReturnUrl ?? "/me"
                });

            if (result.Ok)
            {
                Navigation.NavigateTo(NormalizeApiReturnUrl(result.ReturnUrl, "/me"), forceLoad: true);
                return;
            }

            apiError = MapAuthError(result.Error, result.Status == 409 ? "이미 사용 중인 슬로거 홈 @주소입니다." : "지식 로그 홈을 만들지 못했습니다.");
        }
        catch (Exception)
        {
            apiError = "지식 로그 홈 생성 처리 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool TryNormalizeRelativeReturnUrl(string? returnUrl, out string safeUrl)
    {
        safeUrl = string.Empty;

        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return false;
        }

        return ReturnUrlNormalizer.TryNormalizeLocalPath(returnUrl, out safeUrl, Navigation.BaseUri);
    }

    private string GetLoginHref()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl) || !TryNormalizeRelativeReturnUrl(ReturnUrl, out var safeUrl))
        {
            return "/login";
        }

        return $"/login?returnUrl={Uri.EscapeDataString(safeUrl)}";
    }

    private string NormalizeApiReturnUrl(string? returnUrl, string fallback)
    {
        return TryNormalizeRelativeReturnUrl(returnUrl, out var safeUrl)
            ? safeUrl
            : fallback;
    }

    private static string MapAuthError(string? error, string fallback)
    {
        return error switch
        {
            "required" => "슬로거 홈 @주소와 비밀번호는 필수입니다.",
            "passwordLength" => "비밀번호는 4자 이상이어야 합니다.",
            "passwordMismatch" => "비밀번호가 일치하지 않습니다.",
            "displayNameLength" => "표시 이름은 30자 이하여야 합니다.",
            "profileImageUrlLength" => "슬로거 홈 이미지 URL은 500자 이하여야 합니다.",
            "profileImageUrlInvalid" => "슬로거 홈 이미지 URL은 http, https 또는 /uploads 경로여야 합니다.",
            "profileBioLength" => "홈 소개는 280자 이하여야 합니다.",
            "duplicate" => "이미 사용 중인 슬로거 홈 @주소입니다.",
            "registerFailed" => "지식 로그 홈을 만들지 못했습니다.",
            _ => fallback
        };
    }

    private static bool IsValidProfileImageUrl(string? value)
    {
        var normalized = value?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return true;
        }

        if (normalized.StartsWith('/', StringComparison.Ordinal))
        {
            return true;
        }

        return Uri.TryCreate(normalized, UriKind.Absolute, out var parsed)
            && parsed.Scheme is "http" or "https";
    }

    private string GetPreviewDisplayName()
        => string.IsNullOrWhiteSpace(displayName)
            ? string.IsNullOrWhiteSpace(userName) ? "slogs" : userName.Trim()
            : displayName.Trim();

    private string GetPreviewInitials()
    {
        var source = GetPreviewDisplayName();
        if (string.IsNullOrWhiteSpace(source))
        {
            return "S";
        }

        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1)
        {
            return string.Concat(parts.Take(2).Select(x => x[0])).ToUpperInvariant();
        }

        return source.Length == 1 ? source : source[..Math.Min(2, source.Length)].ToUpperInvariant();
    }

    private sealed class AuthApiResult
    {
        public bool Ok { get; set; }

        public int Status { get; set; }

        public string? Error { get; set; }

        public string? ReturnUrl { get; set; }
    }

}


