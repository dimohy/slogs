@page "/me/settings"
@inject SlogsAuthState AuthState
@inject NavigationManager Navigation

<PageTitle>지식 로그 연결</PageTitle>
<SeoHead Title="지식 로그 연결 | slogs" Description="슬로거 홈 정체성, Agent 회상, LLM Wiki 기억, Obsidian 노트 Vault, 공개 로그 흐름을 한 연결 계층으로 이어 둡니다." NoIndex="true" />

@if (CurrentUser is null)
{
    <p class="rounded-2xl border border-slate-200 bg-white p-4 text-slate-500">로그인이 필요합니다. <a class="font-semibold underline" href="@GetLoginHref()">로그인</a>해 주세요.</p>
}
else
{
    <section class="space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">지식 로그 연결</h1>
                <p class="mt-1 text-sm text-slate-500">@CurrentUser.DisplayName 님의 슬로거 홈 정체성, Agent 회상, 기억, 로컬 노트, 공개 로그 흐름을 한 연결 계층으로 이어 둡니다.</p>
            </div>
        </div>

        <section class="settings-connection-layer rounded-2xl border border-slate-200 bg-white p-5" data-settings-connection-layer>
            <div class="max-w-3xl">
                <p class="text-xs font-bold text-slate-500">연결 계층</p>
                <h2 class="mt-1 text-xl font-black text-slate-900">기억과 노트가 로그로 이어지는 경로</h2>
                <p class="mt-2 text-sm leading-6 text-slate-600">Agent는 비공개 기억을 회상하고, Obsidian은 로컬 노트를 원격 노트 Vault에 남기며, 검토된 단서는 게시전 로그와 공개 공유로 이어집니다.</p>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold text-slate-600" data-settings-connection-status>
                <span>슬로거 홈 정체성</span>
                <span class="text-slate-300">/</span>
                <span>Agent 회상 권한</span>
                <span class="text-slate-300">/</span>
                <span>LLM Wiki 기억</span>
                <span class="text-slate-300">/</span>
                <span>노트 Vault 단서</span>
                <span class="text-slate-300">/</span>
                <span>소유자 전용 게시전 로그</span>
                <span class="text-slate-300">/</span>
                <span>공개 공유 흐름</span>
            </div>
            <div class="mt-4 grid gap-2 md:grid-cols-2 xl:grid-cols-4" data-settings-connection-flow>
                <a class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 transition hover:bg-slate-100"
                   href="/me/settings#agent-mcp-connection"
                   data-settings-connection-step="agent">
                    <span class="block text-sm font-black text-slate-900">Agent 회상</span>
                    <span class="mt-1 block text-xs leading-5 text-slate-500">비공개 기억을 회상해 소유자 전용 게시전 로그로 이어 둡니다.</span>
                </a>
                <a class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 transition hover:bg-slate-100"
                   href="/me/llm-wiki/search"
                   data-settings-connection-step="memory">
                    <span class="block text-sm font-black text-slate-900">LLM Wiki 회상</span>
                    <span class="mt-1 block text-xs leading-5 text-slate-500">판단 기준과 작업 맥락을 찾아 게시전 로그로 이어 씁니다.</span>
                </a>
                <a class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 transition hover:bg-slate-100"
                   href="/me/settings#obsidian-sync-connection"
                   data-settings-connection-step="obsidian">
                    <span class="block text-sm font-black text-slate-900">Obsidian 노트 Vault</span>
                    <span class="mt-1 block text-xs leading-5 text-slate-500">frontmatter 단서를 게시전 로그와 LLM Wiki 기억으로 이어 둡니다.</span>
                </a>
                <a class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 transition hover:bg-slate-100"
                   href="/write"
                   data-settings-connection-step="log">
                    <span class="block text-sm font-black text-slate-900">Slogs 로그</span>
                    <span class="mt-1 block text-xs leading-5 text-slate-500">검토된 기억과 노트를 리비전으로 공개 공유합니다.</span>
                </a>
            </div>
        </section>

        <ProfileSettingsForm />
        <LlmWikiMcpSettings />
    </section>
}

@code {
    private AuthUser? CurrentUser => AuthState.CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.EnsureInitializedAsync();
        if (CurrentUser is null)
        {
            Navigation.NavigateTo(GetLoginHref());
        }
    }

    private string GetLoginHref()
    {
        var uri = new Uri(Navigation.Uri);
        var safeReturn = string.IsNullOrWhiteSpace(uri.Query) ? uri.AbsolutePath : uri.PathAndQuery;
        return $"/login?returnUrl={Uri.EscapeDataString(safeReturn)}";
    }
}
