@page "/post"
@using Microsoft.AspNetCore.Components.Web
@inject SlogsApiClient ApiClient
@inject SlogsAuthState AuthState
@inject NavigationManager Navigation

<PageTitle>공개 로그 흐름</PageTitle>
<SeoHead Title="공개 로그 흐름 | slogs"
         Description="slogs의 공개 로그를 시간, 반응, 갱신 흐름으로 회상합니다."
         CanonicalPath="/post"
         NoIndex="@(!string.IsNullOrWhiteSpace(Query))"
         JsonLd="@GetJsonLd()" />

<h1 class="text-2xl font-bold text-slate-900">공개 로그 흐름</h1>
<p class="mb-3 text-sm text-slate-500">사람과 AI가 남긴 공개 로그를 시간, 반응, 갱신 흐름으로 따라갑니다.</p>

<div class="mb-4">
    <div class="flex flex-wrap gap-2">
        <input class="min-w-0 flex-1 rounded-full border border-slate-300 bg-white px-3 py-2 text-sm outline-none transition focus:border-slate-900"
               value="@searchText"
               @oninput="HandleSearchInputChanged"
               @onkeydown="HandleSearchKeyDown"
               placeholder="회상어, #단서, @@@@슬로거"
               aria-label="공개 로그 회상어 입력" />
        <a class="rounded-full border border-slate-300 bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700"
           href="@GetSearchResultHref()">
            회상
        </a>
        @if (!string.IsNullOrWhiteSpace(Query))
        {
            <a class="rounded-full border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
               href="@GetPostQueryQuery(sort: Sort)">
                회상 초기화
            </a>
        }
    </div>
    <p class="mt-2 text-xs text-slate-500">예: design, #ux, @@mina</p>
</div>

<div class="mb-3 flex flex-wrap gap-2">
    <a class="@GetSortChipClass(null)" href="@GetSortQuery(null)">새 로그</a>
    <a class="@GetSortChipClass("popular")" href='@GetSortQuery("popular")'>반응순</a>
    <a class="@GetSortChipClass("updated")" href='@GetSortQuery("updated")'>갱신 흐름</a>
</div>
@if (!string.IsNullOrWhiteSpace(actionMessage))
{
    <p class="mb-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">@actionMessage</p>
}

<section class="slogs-post-list-grid grid grid-cols-1 gap-3 md:grid-cols-2">
    @if (!posts.Any())
    {
        <p class="slogs-post-list-empty rounded-2xl border border-slate-200 bg-white p-4 text-slate-500">@GetEmptyStateText()</p>
    }
    else
    {
        @for (var index = 0; index < posts.Count; index++)
        {
            var post = posts[index];
            <PostLogCard @key="post.Id"
                         Post="post"
                         PostUrl="@GetPostUrl(post)"
                         CommentsUrl="@GetPostCommentsUrl(post)"
                         CurrentUserName="@CurrentUserName"
                         Priority="@IsPriorityCardImage(index)"
                         SummaryMaxLength="220"
                         IsLikeBusy="@IsPostBusy(post.Slug, pendingLikeSlugs)"
                         IsBookmarkBusy="@IsPostBusy(post.Slug, pendingBookmarkSlugs)"
                         OnToggleLike="ToggleLikeAsync"
                         OnToggleBookmark="ToggleBookmarkAsync" />
        }
    }
</section>

<InfiniteScrollSentinel Visible="@(posts.Count > 0)"
                        HasMore="@HasMorePosts"
                        IsLoading="@isLoadingMorePosts"
                        OnLoadMore="LoadMorePostsAsync"
                        ShowDoneText="@(allPosts.Count > PageSize)"
                        DoneText="모든 공개 로그 흐름을 불러왔습니다." />

@code {
    private const int PageSize = 6;

    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private IReadOnlyList<BlogPost> posts = Array.Empty<BlogPost>();
    private IReadOnlyList<BlogPost> allPosts = Array.Empty<BlogPost>();
    private int totalPages;
    private string actionMessage = string.Empty;
    private HashSet<string> pendingLikeSlugs = [];
    private HashSet<string> pendingBookmarkSlugs = [];
    private string searchText = string.Empty;
    private string? normalizedSort;
    private bool isLoadingMorePosts;
    private string currentStateKey = string.Empty;
    private bool HasMorePosts => posts.Count < allPosts.Count;

    [PersistentState]
    public ListPageState<BlogPost>? PrerenderedState { get; set; }

    private AuthUser? CurrentUser => AuthState.CurrentUser;
    private string CurrentUserName => AuthState.CurrentUser?.UserName ?? string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        searchText = Query ?? string.Empty;
        normalizedSort = ListQueryUrlBuilder.NormalizeSortValue(Sort, "latest", "popular", "updated");
        currentStateKey = PageStateKeyBuilder.FromNavigation(Navigation);
        var restoredPrerenderedState = TryRestorePrerenderedState(currentStateKey);

        await AuthState.EnsureInitializedAsync();

        if (restoredPrerenderedState)
        {
            return;
        }

        await LoadPostsAsync();
        CapturePrerenderedState(currentStateKey);
    }

    private async Task LoadPostsAsync(int minimumVisibleCount = PageSize)
    {
        var basePosts = string.IsNullOrWhiteSpace(Query)
            ? await ApiClient.GetLatestAsync(200)
            : await ApiClient.SearchPostsAsync(Query);

        allPosts = normalizedSort switch
        {
            "popular" => basePosts.OrderByDescending(x => x.LikeCount * 2 + x.ViewCount).ThenByDescending(x => x.PublishedAt).ToList(),
            "updated" => basePosts.OrderByDescending(x => x.UpdatedAt).ThenByDescending(x => x.PublishedAt).ToList(),
            _ => basePosts.OrderByDescending(x => x.PublishedAt).ToList()
        };

        totalPages = allPosts.Count == 0 ? 0 : (int)Math.Ceiling(allPosts.Count / (double)PageSize);
        posts = allPosts.Take(Math.Min(allPosts.Count, Math.Max(PageSize, minimumVisibleCount))).ToList();
        isLoadingMorePosts = false;
        actionMessage = string.Empty;
    }

    private Task LoadMorePostsAsync()
    {
        if (isLoadingMorePosts || !HasMorePosts)
        {
            return Task.CompletedTask;
        }

        isLoadingMorePosts = true;
        try
        {
            posts = allPosts.Take(Math.Min(allPosts.Count, posts.Count + PageSize)).ToList();
            CapturePrerenderedState(currentStateKey);
        }
        finally
        {
            isLoadingMorePosts = false;
        }

        return Task.CompletedTask;
    }

    private string GetSortQuery(string? sort)
    {
        if (string.IsNullOrWhiteSpace(sort))
        {
            return GetPostQueryQuery();
        }

        return GetPostQueryQuery(sort);
    }

    private string GetSortChipClass(string? sort)
    {
        var target = (sort ?? string.Empty).Trim().ToLowerInvariant();
        var current = string.IsNullOrWhiteSpace(normalizedSort) ? "latest" : normalizedSort!;
        var isActive = (target == "latest" ? string.IsNullOrWhiteSpace(current) || current == "latest" : current == target);

        return isActive
            ? "rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white"
            : "rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100";
    }

    private string GetSearchResultHref()
    {
        var normalizedSearch = searchText.Trim();
        return GetPostQueryQuery(sort: normalizedSort, query: normalizedSearch);
    }

    private string GetEmptyStateText()
    {
        if (string.IsNullOrWhiteSpace(Query))
        {
            return "아직 공개 로그 흐름이 없습니다.";
        }

        return $"\"{Query}\"에 이어지는 공개 로그가 없습니다.";
    }

    private void HandleSearchInputChanged(ChangeEventArgs e)
    {
        searchText = e?.Value?.ToString() ?? string.Empty;
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(GetSearchResultHref());
        }
    }

    private string GetPostQueryQuery(string? sort = null, string? query = null, int? page = null)
    {
        var normalizedQuery = query ?? Query;
        var normalizedSortValue = ListQueryUrlBuilder.NormalizeSortValue(sort, "latest", "popular", "updated") ?? normalizedSort;
        var normalizedPage = page ?? 1;

        return ListQueryUrlBuilder.Build("/post", normalizedSortValue, normalizedQuery, normalizedPage, totalPages);
    }

    private static string GetPostUrl(BlogPost post)
        => PostNavigationUrlBuilder.BuildPostUrl(post, PostNavigationUrlBuilder.GlobalMenuContext);

    private static string GetPostCommentsUrl(BlogPost post)
        => PostNavigationUrlBuilder.BuildCommentsUrl(post, PostNavigationUrlBuilder.GlobalMenuContext);

    private bool IsPostBusy(string slug, HashSet<string> busySet) => busySet.Contains(slug);

    private static bool IsPriorityCardImage(int index) => index < 2;

    private string? GetJsonLd()
        => !string.IsNullOrWhiteSpace(Query)
            ? null
            : SeoMetadata.PublicLogCollectionJsonLd(
                Navigation.BaseUri,
                "/post",
                "slogs 공개 로그 흐름",
                "slogs의 공개 로그를 시간, 반응, 갱신 흐름으로 회상합니다.",
                allPosts);

    private async Task ToggleLikeAsync(string slug)
    {
        if (CurrentUser is null)
        {
            NavigateToLogin();
            return;
        }

        if (pendingLikeSlugs.Contains(slug))
        {
            return;
        }

        pendingLikeSlugs.Add(slug);
        actionMessage = string.Empty;
        StateHasChanged();

        try
        {
            await ApiClient.ToggleLikeAsync(slug, CurrentUserName);
            await LoadPostsAsync(Math.Max(posts.Count, PageSize));
            CapturePrerenderedState(currentStateKey);
        }
        finally
        {
            pendingLikeSlugs.Remove(slug);
            actionMessage = string.Empty;
            StateHasChanged();
        }
    }

    private async Task ToggleBookmarkAsync(string slug)
    {
        if (CurrentUser is null)
        {
            NavigateToLogin();
            return;
        }

        if (pendingBookmarkSlugs.Contains(slug))
        {
            return;
        }

        pendingBookmarkSlugs.Add(slug);
        actionMessage = string.Empty;
        StateHasChanged();

        try
        {
            await ApiClient.ToggleBookmarkAsync(slug, CurrentUserName);
            await LoadPostsAsync(Math.Max(posts.Count, PageSize));
            CapturePrerenderedState(currentStateKey);
        }
        finally
        {
            pendingBookmarkSlugs.Remove(slug);
            actionMessage = string.Empty;
            StateHasChanged();
        }
    }

    private void NavigateToLogin()
    {
        var returnUrl = GetCurrentPathWithQuery();
        var encoded = Uri.EscapeDataString(string.IsNullOrWhiteSpace(returnUrl) ? "/post" : returnUrl);
        Navigation.NavigateTo($"/login?returnUrl={encoded}");
    }

    private string GetCurrentPathWithQuery()
    {
        var uri = new Uri(Navigation.Uri);
        return string.IsNullOrWhiteSpace(uri.Query) ? uri.AbsolutePath : uri.PathAndQuery;
    }

    private static string FormatDate(DateTime dateTime) => dateTime.ToLocalTime().ToString("yyyy.MM.dd");

    private bool TryRestorePrerenderedState(string stateKey)
    {
        if (PrerenderedState?.StateKey != stateKey)
        {
            return false;
        }

        posts = PrerenderedState.Items;
        allPosts = PrerenderedState.AllItems;
        totalPages = PrerenderedState.TotalPages;
        normalizedSort = PrerenderedState.NormalizedSort;
        actionMessage = PrerenderedState.Message ?? string.Empty;
        isLoadingMorePosts = false;
        return true;
    }

    private void CapturePrerenderedState(string stateKey)
    {
        PrerenderedState = new ListPageState<BlogPost>
        {
            StateKey = stateKey,
            Items = posts.ToList(),
            AllItems = allPosts.ToList(),
            TotalCount = allPosts.Count,
            TotalPages = totalPages,
            NormalizedSort = normalizedSort,
            Message = actionMessage
        };
    }
}


