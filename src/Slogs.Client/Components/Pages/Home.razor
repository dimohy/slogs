@page "/"
@page "/recent"
@page "/trending"
@page "/recommended"
@page "/feed"
@inject SlogsApiClient ApiClient
@inject SlogsAuthState AuthState
@inject NavigationManager Navigation
<PageTitle>@GetSeoTitle()</PageTitle>
<SeoHead Title="@GetSeoTitle()"
         Description="@GetSeoDescription()"
         CanonicalPath="@GetSeoCanonicalPath()"
         NoIndex="@ShouldNoIndex"
         JsonLd="@(SeoMetadata.WebSiteJsonLd(Navigation.BaseUri))" />

<div class="slogs-home-tabs mb-4 flex flex-wrap items-center gap-2" data-enhance-nav="false">
    <div class="flex flex-wrap gap-2">
        <a class="@GetDiscoveryTabClass("trending")" href="@TrendingHref" @onclick="() => NavigateHomeLink(TrendingHref)" @onclick:preventDefault="true">반응 회상</a>
        <a class="@GetDiscoveryTabClass("recommended")" href="@RecommendedHref" @onclick="() => NavigateHomeLink(RecommendedHref)" @onclick:preventDefault="true">의미 회상</a>
        <a class="@GetDiscoveryTabClass("recent")" href="@RecentHref" @onclick="() => NavigateHomeLink(RecentHref)" @onclick:preventDefault="true">최근 흐름</a>
        <a class="@GetDiscoveryTabClass("feed")" href="@FeedHref" @onclick="() => NavigateHomeLink(FeedHref)" @onclick:preventDefault="true">이어 둔 로그</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Query))
    {
        <a class="inline-flex rounded-full border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
           href="@GetHomeQuery(sort: normalizedSort, feed: normalizedFeed, period: normalizedPeriod)">
            회상 초기화
        </a>
    }
</div>

@if (UsesPeriodRecall)
{
    <div class="slogs-home-period mb-4 flex flex-wrap items-center gap-2" aria-label="로그 흐름 기간">
        <span class="text-xs font-bold text-slate-500">흐름 범위</span>
        <a class="@GetPeriodChipClass("week")" href="@GetPeriodQuery("week")">최근 7일</a>
        <a class="@GetPeriodChipClass("month")" href="@GetPeriodQuery("month")">최근 30일</a>
        <a class="@GetPeriodChipClass("all")" href="@GetPeriodQuery("all")">전체</a>
    </div>
}

<section class="slogs-home-flowline mb-4" aria-label="현재 지식 로그 흐름">
    <div class="min-w-0">
        <p class="text-xs font-bold text-slate-500">현재 흐름</p>
        <h1 class="text-lg font-bold text-slate-950">@GetVisibleFlowTitle()</h1>
        <p class="mt-1 text-sm text-slate-600">@GetVisibleFlowDescription()</p>
    </div>
    <div class="slogs-home-flowline__signals" aria-label="흐름 신호">
        <span>@FormatLogNodeCount(totalCount)</span>
        <span>@GetFlowScopeLabel()</span>
    </div>
</section>

    @if (!string.IsNullOrWhiteSpace(displayedSearchMessage))
    {
        <p class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-500">
            @displayedSearchMessage
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <p class="mb-4 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
            @actionMessage
        </p>
    }

<section class="slogs-post-list-grid grid grid-cols-1 gap-3 md:grid-cols-2">
@if (!posts.Any())
{
    @if (IsFollowingFeed && string.IsNullOrWhiteSpace(Query) && CurrentUser is not null)
    {
        <div class="slogs-post-list-empty rounded-2xl border border-slate-200 bg-white p-4">
            <p class="text-slate-500">아직 이어 둔 로그 홈의 공개 흐름이 없습니다.</p>
            <a class="mt-2 inline-block rounded-full border border-slate-300 bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-800"
               href="/writer">
                슬로거 찾아보기
            </a>
        </div>
    }
    else
    {
        <p class="slogs-post-list-empty rounded-2xl border border-slate-200 bg-white p-4 text-slate-500">@GetHomeEmptyStateText()</p>
    }
}
else
{
    for (var index = 0; index < posts.Count; index++)
    {
        var post = posts[index];
        <PostLogCard @key="post.Id"
                     Post="post"
                     PostUrl="@GetPostUrl(post)"
                     CommentsUrl="@GetPostCommentsUrl(post)"
                     CurrentUserName="@CurrentUserName"
                     Priority="@IsPriorityCardImage(index)"
                     IsLikeBusy="@IsPostBusy(post.Slug, pendingLikeSlugs)"
                     IsBookmarkBusy="@IsPostBusy(post.Slug, pendingBookmarkSlugs)"
                     OnToggleLike="ToggleLikeAsync"
                     OnToggleBookmark="ToggleBookmarkAsync" />
    }
}
</section>

<InfiniteScrollSentinel Visible="@(posts.Count > 0)"
                        HasMore="@HasMorePosts"
                        IsLoading="@isLoadingMorePosts"
                        OnLoadMore="LoadMorePostsAsync"
                        ShowDoneText="@(totalCount > PageSize)"
                        DoneText="현재 지식 로그 흐름을 모두 불러왔습니다." />
@code {
    private const int PageSize = 6;
    private const string TrendingHref = "/trending";
    private const string RecommendedHref = "/recommended";
    private const string RecentHref = "/recent";
    private const string FeedHref = "/feed";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "feed")]
    public string? Feed { get; set; }
    [SupplyParameterFromQuery(Name = "period")]
    public string? Period { get; set; }
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    private IReadOnlyList<BlogPost> posts = Array.Empty<BlogPost>();
    private IReadOnlyList<BlogPost> allPosts = Array.Empty<BlogPost>();
    private int currentPage;
    private int totalCount;
    private int totalPages;
    private int visiblePostCount = PageSize;
    private string? displayedSearchMessage;
    private string actionMessage = string.Empty;
    private bool allPostsLoaded;
    private bool isLoadingMorePosts;
    private HashSet<string> pendingLikeSlugs = [];
    private HashSet<string> pendingBookmarkSlugs = [];
    private string? normalizedSort;
    private string? normalizedFeed;
    private string normalizedPeriod = "week";
    private string discoveryMode = "recent";
    private string currentStateKey = string.Empty;

    private bool HasMorePosts => posts.Count < totalCount;

    [PersistentState]
    public HomePageState? PrerenderedState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        currentPath = string.IsNullOrWhiteSpace(currentPath) ? "/" : currentPath;
        isFeedPageRoute = string.Equals(currentPath, "/feed", StringComparison.OrdinalIgnoreCase);
        discoveryMode = ResolveDiscoveryMode(currentPath);
        var effectiveFeed = isFeedPageRoute
            ? "following"
            : Feed;
        var requestedSort = string.IsNullOrWhiteSpace(Sort)
            ? GetDefaultSortForDiscoveryMode(discoveryMode)
            : Sort;

        normalizedSort = ListQueryUrlBuilder.NormalizeSortValue(requestedSort, "latest", "popular", "updated", "recommended");
        normalizedFeed = ListQueryUrlBuilder.NormalizeFeedValue(effectiveFeed);
        normalizedPeriod = NormalizePeriodValue(Period);

        if (isFeedPageRoute && !string.IsNullOrWhiteSpace(Feed)
            && !string.Equals(Feed, "following", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(GetHomeQuery(sort: normalizedSort, feed: "following", query: Query), forceLoad: true);
            return;
        }

        if (IsFollowingFeed && !isFeedPageRoute)
        {
            Navigation.NavigateTo(GetHomeQuery(sort: normalizedSort, feed: "following", query: Query), forceLoad: true);
            return;
        }

        currentStateKey = BuildStateKey(currentPath, Query, normalizedSort, normalizedFeed, UsesPeriodRecall ? normalizedPeriod : null);
        var restoredPrerenderedState = TryRestorePrerenderedState(currentStateKey);

        await AuthState.EnsureInitializedAsync();

        if (IsFollowingFeed && string.IsNullOrWhiteSpace(CurrentUserName))
        {
            NavigateToLogin(GetCurrentPathWithQuery());
            return;
        }

        if (restoredPrerenderedState)
        {
            return;
        }

        await LoadPostsAsync(PageSize);
        CapturePrerenderedState(currentStateKey);
    }

    public async Task<bool> LoadMorePostsAsync()
    {
        if (isLoadingMorePosts || !HasMorePosts)
        {
            return false;
        }

        isLoadingMorePosts = true;
        await InvokeAsync(StateHasChanged);

        var previousCount = posts.Count;
        try
        {
            if (!allPostsLoaded)
            {
                await RefreshAllPostsAsync();
            }

            visiblePostCount = Math.Min(totalCount, Math.Max(posts.Count + PageSize, PageSize));
            ApplyVisiblePosts();
            CapturePrerenderedState(currentStateKey);
        }
        finally
        {
            isLoadingMorePosts = false;
            await InvokeAsync(StateHasChanged);
        }

        return posts.Count > previousCount;
    }

    private async Task LoadPostsAsync(int minimumVisibleCount)
    {
        visiblePostCount = Math.Max(PageSize, minimumVisibleCount);
        await RefreshAllPostsAsync();
        ApplyVisiblePosts();
    }

    private async Task RefreshAllPostsAsync()
    {
        displayedSearchMessage = null;
        actionMessage = string.Empty;

        var normalizedQuery = Query?.Trim();
        var structuredSearch = ResolveSearchDestination(normalizedQuery);

        var allPosts = string.IsNullOrWhiteSpace(Query)
            ? await GetDefaultPostSourceAsync()
            : structuredSearch is null
                ? await ApiClient.SearchPostsAsync(Query)
                : await structuredSearch.Value.QueryHandler();

        if (IsFollowingFeed)
        {
            allPosts = await ApplyFollowingScopeAsync(allPosts);
        }

        allPosts = ApplyPeriodScope(allPosts);

        if (string.IsNullOrWhiteSpace(Query) && IsFollowingFeed && CurrentUser is null)
        {
            displayedSearchMessage = "이어 둔 로그 흐름을 보려면 지식 로그 홈으로 돌아가야 합니다.";
        }
        else if (string.IsNullOrWhiteSpace(Query) && IsFollowingFeed && !allPosts.Any())
        {
            displayedSearchMessage = "아직 이어 둔 로그 홈이 없습니다. 슬로거 홈에서 관계를 이어 보세요.";
        }

        if (IsSearchOnlyPrefix(Query))
        {
            displayedSearchMessage = $"{GetDisplayedQuery()} 뒤에 회상할 단서를 입력해 주세요.";
        }
        else if (!string.IsNullOrWhiteSpace(Query) && allPosts.Count == 0)
        {
            displayedSearchMessage = IsFollowingFeed
                ? $"이어 둔 로그 흐름에서 \"{GetDisplayedQuery()}\"와 이어지는 회상 흐름이 없습니다."
                : UsesPeriodRecall && normalizedPeriod != "all"
                    ? $"{GetPeriodLabel(normalizedPeriod)} \"{GetDisplayedQuery()}\"와 이어지는 회상 흐름이 없습니다."
                    : $"\"{GetDisplayedQuery()}\"와 이어지는 의미 회상 흐름이 없습니다.";
        }
        else if (string.IsNullOrWhiteSpace(Query) && UsesPeriodRecall && normalizedPeriod != "all" && allPosts.Count == 0)
        {
            displayedSearchMessage = $"{GetPeriodLabel(normalizedPeriod)} 이어진 로그가 없습니다. 전체 흐름으로 넓혀 볼 수 있습니다.";
        }

        allPosts = SortPosts(allPosts);
        totalCount = allPosts.Count;
        totalPages = totalCount == 0 ? 0 : (int)Math.Ceiling(totalCount / (double)PageSize);
        this.allPosts = allPosts;
        allPostsLoaded = true;
    }

    private void ApplyVisiblePosts()
    {
        if (totalCount == 0)
        {
            posts = Array.Empty<BlogPost>();
            visiblePostCount = 0;
            currentPage = 1;
            return;
        }

        visiblePostCount = Math.Min(Math.Max(PageSize, visiblePostCount), totalCount);
        posts = allPosts.Take(visiblePostCount).ToList();
        currentPage = (int)Math.Ceiling(posts.Count / (double)PageSize);
    }

    private bool TryRestorePrerenderedState(string stateKey)
    {
        if (PrerenderedState?.StateKey != stateKey)
        {
            return false;
        }

        posts = PrerenderedState.Posts;
        allPosts = PrerenderedState.Posts;
        allPostsLoaded = PrerenderedState.Posts.Count >= PrerenderedState.TotalCount;
        visiblePostCount = Math.Max(PageSize, PrerenderedState.VisiblePostCount == 0
            ? PrerenderedState.Posts.Count
            : PrerenderedState.VisiblePostCount);
        currentPage = PrerenderedState.CurrentPage;
        totalCount = PrerenderedState.TotalCount;
        totalPages = PrerenderedState.TotalPages;
        displayedSearchMessage = PrerenderedState.DisplayedSearchMessage;
        normalizedSort = PrerenderedState.NormalizedSort;
        normalizedFeed = PrerenderedState.NormalizedFeed;
        normalizedPeriod = string.IsNullOrWhiteSpace(PrerenderedState.NormalizedPeriod)
            ? normalizedPeriod
            : PrerenderedState.NormalizedPeriod;
        discoveryMode = string.IsNullOrWhiteSpace(PrerenderedState.DiscoveryMode)
            ? discoveryMode
            : PrerenderedState.DiscoveryMode;
        return true;
    }

    private void CapturePrerenderedState(string stateKey)
    {
        PrerenderedState = new HomePageState
        {
            StateKey = stateKey,
            Posts = posts.ToList(),
            VisiblePostCount = posts.Count,
            CurrentPage = currentPage,
            TotalCount = totalCount,
            TotalPages = totalPages,
            DisplayedSearchMessage = displayedSearchMessage,
            NormalizedSort = normalizedSort,
            NormalizedFeed = normalizedFeed,
            NormalizedPeriod = UsesPeriodRecall ? normalizedPeriod : null,
            DiscoveryMode = discoveryMode
        };
    }

    private string CurrentUserName => AuthState.CurrentUser?.UserName ?? string.Empty;
    private AuthUser? CurrentUser => AuthState.CurrentUser;

    private static string GetPostUrl(BlogPost post)
        => PostNavigationUrlBuilder.BuildPostUrl(post, PostNavigationUrlBuilder.GlobalMenuContext);

    private static string GetPostCommentsUrl(BlogPost post)
        => PostNavigationUrlBuilder.BuildCommentsUrl(post, PostNavigationUrlBuilder.GlobalMenuContext);

    private async Task ToggleLikeAsync(string slug)
    {
        if (CurrentUser is null)
        {
            NavigateToLogin(GetLoginReturnUrl());
            return;
        }

        if (pendingLikeSlugs.Contains(slug))
        {
            return;
        }

        pendingLikeSlugs.Add(slug);
        actionMessage = string.Empty;
        StateHasChanged();

        try
        {
            await ApiClient.ToggleLikeAsync(slug, CurrentUser.UserName);
            await LoadPostsAsync(Math.Max(posts.Count, PageSize));
        }
        finally
        {
            pendingLikeSlugs.Remove(slug);
            actionMessage = string.Empty;
            StateHasChanged();
        }
    }

    private async Task ToggleBookmarkAsync(string slug)
    {
        if (CurrentUser is null)
        {
            NavigateToLogin(GetLoginReturnUrl());
            return;
        }

        if (pendingBookmarkSlugs.Contains(slug))
        {
            return;
        }

        pendingBookmarkSlugs.Add(slug);
        actionMessage = string.Empty;
        StateHasChanged();

        try
        {
            await ApiClient.ToggleBookmarkAsync(slug, CurrentUser.UserName);
            await LoadPostsAsync(Math.Max(posts.Count, PageSize));
        }
        finally
        {
            pendingBookmarkSlugs.Remove(slug);
            actionMessage = string.Empty;
            StateHasChanged();
        }
    }

    private bool IsPostBusy(string slug, HashSet<string> busySet) => busySet.Contains(slug);

    private static bool IsPriorityCardImage(int index) => index < 2;

    private async Task<IReadOnlyList<BlogPost>> GetDefaultPostSourceAsync()
    {
        if (!IsFollowingFeed)
        {
            return await ApiClient.GetLatestAsync(200);
        }

        var following = await ApiClient.GetFollowingAsync(CurrentUserName);
        var followingPosts = await ApiClient.GetByAuthorsAsync(following);
        return followingPosts;
    }

    private async Task<IReadOnlyList<BlogPost>> ApplyFollowingScopeAsync(IReadOnlyList<BlogPost> source)
    {
        if (!IsFollowingFeed)
        {
            return source;
        }

        var following = await ApiClient.GetFollowingAsync(CurrentUserName);
        if (following.Count == 0)
        {
            return Array.Empty<BlogPost>();
        }

        var followingSet = following.ToHashSet(StringComparer.OrdinalIgnoreCase);
        return source.Where(x => followingSet.Contains(x.Author)).ToList();
    }

    private IReadOnlyList<BlogPost> ApplyPeriodScope(IReadOnlyList<BlogPost> source)
    {
        if (!UsesPeriodRecall || normalizedPeriod == "all")
        {
            return source;
        }

        var threshold = normalizedPeriod == "month"
            ? DateTime.UtcNow.AddDays(-30)
            : DateTime.UtcNow.AddDays(-7);

        return source
            .Where(post => GetLogActivityAt(post) >= threshold)
            .ToList();
    }

    private void NavigateToLogin(string returnUrl)
    {
        var encoded = Uri.EscapeDataString(string.IsNullOrWhiteSpace(returnUrl) ? "/" : returnUrl);
        Navigation.NavigateTo($"/login?returnUrl={encoded}");
    }

    private string GetCurrentPathWithQuery()
    {
        var uri = new Uri(Navigation.Uri);
        return string.IsNullOrWhiteSpace(uri.Query) ? uri.AbsolutePath : $"{uri.AbsolutePath}{uri.Query}";
    }

    private string GetDiscoveryTitle()
    {
        return discoveryMode switch
        {
            "trending" => $"{GetPeriodTitlePrefix()} 반응으로 이어진 로그",
            "recommended" => $"{GetPeriodTitlePrefix()} 의미가 이어진 로그",
            "feed" => "이어 둔 로그 흐름",
            _ => "최근 공개 로그 흐름"
        };
    }

    private string GetDiscoveryDescription()
    {
        return discoveryMode switch
        {
            "trending" => $"{GetPeriodLabel(normalizedPeriod)} 회상 접근, 대화 흔적, 공감 신호로 다시 이어진 공개 로그 흐름을 따라갑니다.",
            "recommended" => $"{GetPeriodLabel(normalizedPeriod)} 회상 접근, 대화 흔적, 공감 신호, 단서, 시리즈가 겹치는 다음 의미 경로를 따라갑니다.",
            "feed" => "관계로 이어 둔 슬로거의 공개 로그 흐름만 따라갑니다.",
            _ => "사람과 AI가 이어 쓰는 공개 지식 로그 흐름입니다."
        };
    }

    private string GetVisibleFlowTitle()
    {
        return string.IsNullOrWhiteSpace(Query)
            ? GetDiscoveryTitle()
            : $"{GetDisplayedQuery()} 의미 회상";
    }

    private string GetVisibleFlowDescription()
    {
        return string.IsNullOrWhiteSpace(Query)
            ? GetDiscoveryDescription()
            : $"단서, 슬로거, 시리즈, 본문 흐름에서 \"{GetDisplayedQuery()}\"와 이어지는 공개 로그를 회상합니다.";
    }

    private string GetFlowScopeLabel()
    {
        if (IsFollowingFeed)
        {
            return "관계 흐름";
        }

        return UsesPeriodRecall
            ? GetPeriodLabel(normalizedPeriod)
            : "공개 흐름";
    }

    private static string FormatLogNodeCount(int count)
        => $"{count:N0}개 로그 노드";

    private string GetSeoTitle()
    {
        return string.IsNullOrWhiteSpace(Query)
            ? $"{GetDiscoveryTitle()} | slogs"
            : $"{GetDisplayedQuery()} 의미 회상 흐름 | slogs";
    }

    private string GetSeoDescription()
    {
        return string.IsNullOrWhiteSpace(Query)
            ? GetDiscoveryDescription()
            : $"slogs에서 {GetDisplayedQuery()}와 이어지는 의미 회상 흐름을 다시 따라갑니다.";
    }

    private string GetSeoCanonicalPath()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        return string.IsNullOrWhiteSpace(path) ? "/" : path;
    }

    private string GetHomeEmptyStateText()
    {
        if (!string.IsNullOrWhiteSpace(Query))
        {
            return $"\"{GetDisplayedQuery()}\"에 이어지는 의미 회상 로그가 없습니다.";
        }

        if (UsesPeriodRecall && normalizedPeriod != "all")
        {
            return $"{GetPeriodLabel(normalizedPeriod)} 이어진 로그 흐름이 없습니다.";
        }

        return "아직 이어진 공개 로그 흐름이 없습니다.";
    }

    private bool ShouldNoIndex => IsFollowingFeed || !string.IsNullOrWhiteSpace(Query);

    private string GetDiscoveryTabClass(string mode)
    {
        return string.Equals(discoveryMode, mode, StringComparison.OrdinalIgnoreCase)
            ? "rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white"
            : "rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100";
    }

    private string GetLoginReturnUrl()
    {
        return GetHomeQuery(sort: normalizedSort, feed: normalizedFeed, query: Query, period: normalizedPeriod);
    }

    private void NavigateHomeLink(string href)
    {
        Navigation.NavigateTo(href, forceLoad: true);
    }

    private IReadOnlyList<BlogPost> SortPosts(IEnumerable<BlogPost> source)
    {
        return normalizedSort switch
        {
            "popular" => source.OrderByDescending(x => x.LikeCount * 2 + x.ViewCount).ThenByDescending(x => x.PublishedAt).ToList(),
            "recommended" => source.OrderByDescending(GetRecommendedScore).ThenByDescending(x => x.UpdatedAt).ThenByDescending(x => x.PublishedAt).ToList(),
            "updated" => source.OrderByDescending(x => x.UpdatedAt).ThenByDescending(x => x.PublishedAt).ToList(),
            _ => source.OrderByDescending(x => x.PublishedAt).ToList()
        };
    }

    private static int GetRecommendedScore(BlogPost post)
    {
        return post.LikeCount * 4
            + post.CommentCount * 3
            + post.ViewCount
            + post.Tags.Count
            + post.Series.Count * 2
            + Math.Min(post.ReadTimeMinutes, 20);
    }

    private (string? Display, Func<Task<IReadOnlyList<BlogPost>>> QueryHandler)? ResolveSearchDestination(string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        if (query.StartsWith("#", StringComparison.Ordinal))
        {
            var tag = query[1..].Trim();
            return string.IsNullOrWhiteSpace(tag)
                ? ("단서", () => GetFallbackQueryPostsAsync())
                : ($"# {tag}", () => ApiClient.GetByTagAsync(tag));
        }

        if (query.StartsWith("@@", StringComparison.Ordinal))
        {
            var writer = query[2..].Trim();
            return string.IsNullOrWhiteSpace(writer)
                ? ("슬로거", () => GetFallbackQueryPostsAsync())
                : ($"슬로거: {writer}", () => ApiClient.GetByAuthorAsync(writer));
        }

        if (query.StartsWith("@", StringComparison.Ordinal))
        {
            var writer = query[1..].Trim();
            return string.IsNullOrWhiteSpace(writer)
                ? ("슬로거", () => GetFallbackQueryPostsAsync())
                : ($"슬로거: {writer}", () => ApiClient.GetByAuthorAsync(writer));
        }

        if (TryReadRecallPrefix(query, ["tag:", "단서:"], out var tagValue))
        {
            return string.IsNullOrWhiteSpace(tagValue)
                ? ("단서", () => GetFallbackQueryPostsAsync())
                : ($"단서: {tagValue}", () => ApiClient.GetByTagAsync(tagValue));
        }

        if (TryReadRecallPrefix(query, ["writer:", "슬로거:"], out var writerValue))
        {
            return string.IsNullOrWhiteSpace(writerValue)
                ? ("슬로거", () => GetFallbackQueryPostsAsync())
                : ($"슬로거: {writerValue}", () => ApiClient.GetByAuthorAsync(writerValue));
        }

        if (TryReadRecallPrefix(query, ["series:", "시리즈:", "로그 시리즈:"], out var seriesValue))
        {
            return string.IsNullOrWhiteSpace(seriesValue)
                ? ("시리즈", () => GetFallbackQueryPostsAsync())
                : ($"로그 시리즈: {seriesValue}", () => ApiClient.GetBySeriesAsync(seriesValue));
        }

        return null;
    }

    private string GetDisplayedQuery()
    {
        var structured = ResolveSearchDestination(Query);
        if (structured is null)
        {
            return Query ?? string.Empty;
        }

        return structured.Value.Display ?? Query ?? string.Empty;
    }

    private static bool IsSearchOnlyPrefix(string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return false;
        }

        var trimmed = query.Trim();
        return trimmed is "#" or "@"
            || trimmed is "@@"
            || IsRecallPrefixOnly(trimmed, ["tag:", "단서:", "writer:", "슬로거:", "series:", "시리즈:", "로그 시리즈:"]);
    }

    private static bool TryReadRecallPrefix(string value, IReadOnlyList<string> prefixes, out string remainder)
    {
        foreach (var prefix in prefixes)
        {
            if (!value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            remainder = value[prefix.Length..].Trim();
            return true;
        }

        remainder = string.Empty;
        return false;
    }

    private static bool IsRecallPrefixOnly(string value, IReadOnlyList<string> prefixes)
        => prefixes.Any(prefix => value.Equals(prefix, StringComparison.OrdinalIgnoreCase));

    private Task<IReadOnlyList<BlogPost>> GetFallbackQueryPostsAsync()
    {
        return ApiClient.GetLatestAsync(200);
    }

    private string GetSortChipClass(string? sort)
    {
        var target = (sort ?? string.Empty).Trim().ToLowerInvariant();
        var current = string.IsNullOrWhiteSpace(normalizedSort) ? "latest" : normalizedSort!;
        var isActive = (target == "latest" ? string.IsNullOrWhiteSpace(current) || current == "latest" : current == target);

        return isActive
            ? "rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white"
            : "rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100";
    }

    private string GetHomeQuery(string? sort, string? feed = null, string? query = null, int? page = null, string? period = null)
    {
        var isFollowing = string.Equals(feed, "following", StringComparison.OrdinalIgnoreCase);
        var basePath = isFollowing
            ? "/feed"
            : GetBasePathForSort(sort);
        var builderFeed = string.Equals(feed, "following", StringComparison.OrdinalIgnoreCase) ? null : feed;
        var builderSort = IsDefaultSortForBasePath(basePath, sort) ? null : sort;
        var path = ListQueryUrlBuilder.Build(basePath, builderSort, query, page ?? 1, totalPages, builderFeed);
        var normalizedPeriodValue = NormalizePeriodValue(period);
        return ShouldIncludePeriod(basePath, normalizedPeriodValue)
            ? AppendQueryParameter(path, "period", normalizedPeriodValue)
            : path;
    }

    private static string ResolveDiscoveryMode(string path)
    {
        if (string.Equals(path, "/trending", StringComparison.OrdinalIgnoreCase))
        {
            return "trending";
        }

        if (string.Equals(path, "/recommended", StringComparison.OrdinalIgnoreCase))
        {
            return "recommended";
        }

        if (string.Equals(path, "/feed", StringComparison.OrdinalIgnoreCase))
        {
            return "feed";
        }

        return "recent";
    }

    private static string BuildStateKey(string path, string? query, string? sort, string? feed, string? period)
    {
        return string.Join('|', [
            path.Trim().ToLowerInvariant(),
            query?.Trim() ?? string.Empty,
            sort?.Trim().ToLowerInvariant() ?? string.Empty,
            feed?.Trim().ToLowerInvariant() ?? string.Empty,
            period?.Trim().ToLowerInvariant() ?? string.Empty
        ]);
    }

    private static string? GetDefaultSortForDiscoveryMode(string mode)
    {
        return mode switch
        {
            "trending" => "popular",
            "recommended" => "recommended",
            _ => null
        };
    }

    private static string GetBasePathForSort(string? sort)
    {
        return sort switch
        {
            "popular" => "/trending",
            "recommended" => "/recommended",
            _ => "/recent"
        };
    }

    private static bool IsDefaultSortForBasePath(string basePath, string? sort)
    {
        return (string.Equals(basePath, "/trending", StringComparison.OrdinalIgnoreCase)
                && string.Equals(sort, "popular", StringComparison.OrdinalIgnoreCase))
            || (string.Equals(basePath, "/recommended", StringComparison.OrdinalIgnoreCase)
                && string.Equals(sort, "recommended", StringComparison.OrdinalIgnoreCase))
            || (string.Equals(basePath, "/recent", StringComparison.OrdinalIgnoreCase)
                && string.IsNullOrWhiteSpace(sort));
    }

    private bool IsFollowingFeed => string.Equals(normalizedFeed, "following", StringComparison.OrdinalIgnoreCase);
    private bool UsesPeriodRecall => discoveryMode is "trending" or "recommended";
    private bool isFeedPageRoute;

    private string GetPeriodQuery(string period)
        => GetHomeQuery(sort: normalizedSort, feed: normalizedFeed, query: Query, period: period);

    private string GetPeriodChipClass(string period)
    {
        var isActive = string.Equals(normalizedPeriod, NormalizePeriodValue(period), StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white"
            : "rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100";
    }

    private static string NormalizePeriodValue(string? period)
    {
        if (string.IsNullOrWhiteSpace(period))
        {
            return "week";
        }

        return period.Trim().ToLowerInvariant() switch
        {
            "month" => "month",
            "all" => "all",
            _ => "week"
        };
    }

    private static string GetPeriodLabel(string period)
    {
        return NormalizePeriodValue(period) switch
        {
            "month" => "최근 30일 동안",
            "all" => "전체 흐름에서",
            _ => "최근 7일 동안"
        };
    }

    private string GetPeriodTitlePrefix()
    {
        return normalizedPeriod switch
        {
            "month" => "최근 30일",
            "all" => "전체 흐름",
            _ => "최근 7일"
        };
    }

    private static bool ShouldIncludePeriod(string basePath, string period)
    {
        return !string.Equals(period, "week", StringComparison.OrdinalIgnoreCase)
            && (string.Equals(basePath, "/trending", StringComparison.OrdinalIgnoreCase)
                || string.Equals(basePath, "/recommended", StringComparison.OrdinalIgnoreCase));
    }

    private static DateTime GetLogActivityAt(BlogPost post)
        => post.UpdatedAt > post.PublishedAt ? post.UpdatedAt : post.PublishedAt;

    private static string AppendQueryParameter(string path, string name, string value)
    {
        var separator = path.Contains('?') ? "&" : "?";
        return $"{path}{separator}{Uri.EscapeDataString(name)}={Uri.EscapeDataString(value)}";
    }

}


