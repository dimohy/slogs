@page "/me/llm-wiki"
@inject SlogsAuthState AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>LLM Wiki 기억 연결</PageTitle>
<SeoHead Title="LLM Wiki 기억 연결 | slogs" Description="Slogs LLM Wiki가 비공개 기억을 Agent 회상과 소유자 전용 게시전 기억으로 이어 두는 연결면입니다." NoIndex="true" />

@if (CurrentUser is null)
{
    <p class="rounded-2xl border border-slate-200 bg-white p-4 text-slate-500">비공개 기억 연결면을 열려면 지식 로그 홈으로 돌아가야 합니다. <a class="font-semibold underline" href="@GetLoginHref()">지식 로그로 돌아가기</a></p>
}
else
{
    <section class="space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
            <div>
                <p class="text-xs font-bold text-slate-500">slogs 기억 계층</p>
                <h1 class="mt-1 text-2xl font-bold text-slate-900">LLM Wiki 기억 연결</h1>
                <p class="mt-1 text-sm text-slate-500">@CurrentUser.DisplayName 님의 비공개 기억을 Agent 회상과 Slogs 게시전 기억으로 이어 두는 연결면입니다.</p>
            </div>
        </div>

        <section class="llm-wiki-flow-panel rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div>
                <p class="text-xs font-bold text-slate-500">기억에서 공개 공유로</p>
                <h2 class="mt-1 text-lg font-bold text-slate-900">LLM Wiki는 공개 공유 노드 뒤의 기억 계층입니다</h2>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
                    Agent가 남긴 판단 기준과 작업 맥락은 비공개 기억으로 축적되고, 필요한 순간 의미 회상에서 소유자 전용 게시전 기억으로 이어집니다. 공개는 게시전 기억을 검토하고 리비전으로 남긴 뒤 사용자가 결정합니다.
                </p>
            </div>
            <div class="llm-wiki-flow-panel__steps mt-4">
                <span>기억 남김</span>
                <span>의미 회상</span>
                <span>게시전 기억</span>
                <span>공개 공유</span>
            </div>
            <div class="mt-4">
                <a class="inline-flex rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-slate-800"
                   href="/me/llm-wiki/search">의미 회상으로 이동</a>
            </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase text-slate-500">기억 흐름 원리</p>
                    <h2 class="mt-1 text-lg font-bold text-slate-900">LLM Wiki는 판단 단서를 GraphRAG 기억 흐름으로 바꿉니다</h2>
                </div>
                <p class="max-w-2xl text-sm leading-6 text-slate-600">
                    자연어로 남긴 판단 단서는 제목, 태그, 요청 흐름, 본문을 함께 기억 신호로 엮습니다. 의미로 회상할 때는 서버 로컬 EmbeddingGemma와 PostgreSQL pgvector, graph node 관계 점수를 결합해 이어 쓸 기억을 찾고 관련도 퍼센트를 표시합니다.
                </p>
            </div>

            <div class="mt-5 grid gap-5 lg:grid-cols-3">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">1. 기억 단서 남김</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">사용자가 남긴 결정, 선호, 판단 기준, 프로젝트 맥락을 하나의 기억 흐름으로 남깁니다. 제목과 태그도 나중에 같은 맥락을 다시 떠올리는 회상 신호로 함께 쓰입니다.</p>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900">2. 의미와 관계 인덱싱</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">내용은 768차원 기억 벡터로 남고, 제목 phrase, 태그, 핵심어는 graph node 관계 신호로 이어집니다. 한국어 조사 차이는 graph token 정규화로 줄입니다.</p>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900">3. 의미 회상</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">회상어 embedding과 graph node를 함께 비교해 이어 쓸 기억의 순위를 만들고, 낮은 관련도 회상 후보는 제외합니다. 퍼센트는 통계적 확률이 아니라 GraphRAG 관련도 점수입니다.</p>
                </div>
            </div>

            <div class="mt-5 grid gap-5 border-t border-slate-200 pt-5 lg:grid-cols-2">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">LLM Agent 정책에 반영할 핵심</h3>
                    <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-6 text-slate-600">
                        <li>이전 결정, 선호, 판단 기준, 프로젝트 맥락이 관련되면 Slogs LLM Wiki에서 먼저 관련 기억을 회상합니다.</li>
                        <li><code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">search</code> 도구는 회상 후보 흐름을 압축해 보여 주고, <code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">recall</code> 도구는 답변/구현에 바로 적용할 기억 맥락으로 이어 줍니다.</li>
                        <li>MCP 회상 응답의 Retrieval Diagnostics로 회상 후보 수, limit, categoryPath, minRelevancePercent, elapsedMs를 살펴 회상 품질을 조율합니다.</li>
                        <li>작업을 마치기 전, 장기적으로 문서화나 자동화에 도움이 될 암묵지 기억 후보를 조용히 점검합니다.</li>
                        <li>사용자가 원치 않는 전개를 정정하거나 조정하면 원치 않았던 흐름, 원한 방향, 다음에 피할 패턴, 적용 범위를 구조화해 기억하도록 안내합니다.</li>
                        <li>기억으로 남기기 전에는 관련 기억을 먼저 회상하고, 중복이면 새 항목이 아니라 기존 항목을 merge/update합니다.</li>
                        <li>정제된 현재 기억과 별도로 원래 기억/병합/갱신 요청은 Raw Provenance에 남겨 회상 품질과 병합 품질을 검증합니다.</li>
                        <li>기억으로 남기거나 병합/갱신할 때 프로젝트/영역/주제를 나타내는 <code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">categoryPath</code>를 명시합니다.</li>
                        <li>복사한 Agent 회상 지침은 Agent 회상 연결 키 입력과 전역/프로젝트/현재 세션 범위 선택을 안내하고, 선택한 범위에 맞춰 Slogs MCP 연결도 함께 설정하도록 합니다.</li>
                        <li>세션 시작 직후 Slogs 도구가 보이지 않으면 비활성화로 단정하지 않고 Agent의 도구 노출 점검으로 먼저 지연 로딩을 살피도록 안내합니다.</li>
                        <li>한국어 <a class="font-semibold text-slate-900 underline" href="/prompts/slogs-mcp.ko.md" target="_blank">slogs-mcp.ko.md</a>와 English <a class="font-semibold text-slate-900 underline" href="/prompts/slogs-mcp.en.md" target="_blank">slogs-mcp.en.md</a>를 언어별 Agent 회상 지침으로 제공합니다.</li>
                        <li>동기화는 버전 URL <a class="font-semibold text-slate-900 underline" href="/prompts/slogs-mcp.version" target="_blank">slogs-mcp.version</a>을 먼저 비교하고, 버전이 다르면 Agent가 같은 지침 위치의 지침 블록을 직접 교체하도록 안내합니다.</li>
                        <li>연결 키, 비밀번호, 토큰, 일회성 로그, 임시 실행 내역은 기억으로 남기지 않습니다.</li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Agent 동작 흐름</h3>
                    <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-sm leading-6 text-slate-600">
                        <li>사용자 요청이 이전 맥락과 관련되는지 판단합니다.</li>
                        <li>Slogs 도구가 처음 보이지 않으면 <code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">tool_search</code> 같은 도구 노출 점검으로 먼저 지연 로딩 여부를 살핍니다.</li>
                        <li>넓거나 애매한 요청은 먼저 <code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">search</code>로 작은 회상 후보 흐름을 잡습니다.</li>
                        <li>답변이나 구현에 바로 적용할 기억 맥락은 낮은 limit의 <code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">recall</code>로 불러옵니다.</li>
                        <li>관련도, 제목, 요약, 태그, Retrieval Diagnostics를 보고 현재 작업에 필요한 기억을 선별합니다.</li>
                        <li>상위 기억이 엉뚱하거나 느리거나 너무 크면 query, categoryPath, limit, minRelevancePercent를 좁혀 다시 회상합니다.</li>
                        <li>새 기억이 필요하면 <code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">capture/find_related</code> 후 <code class="rounded bg-slate-100 px-1 py-0.5 text-xs text-slate-800">categoryPath</code>를 정해 기억으로 남깁니다.</li>
                        <li>항목을 열어 Raw Provenance의 원문 근거와 현재 통합 기억이 일치하는지 점검합니다.</li>
                        <li>일회성 로그, 임시 실행 내역, 검증되지 않은 추측, 현재 파일에서 쉽게 복구 가능한 단순 사실은 기억으로 남기지 않습니다.</li>
                    </ol>
                </div>
            </div>

            <div class="mt-5 border-t border-slate-200 pt-5">
                <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                    <div class="max-w-2xl">
                        <p class="text-xs font-bold uppercase text-slate-500">Agent Recall Instructions</p>
                        <h3 class="mt-1 text-base font-bold text-slate-900">언어별 Agent 회상 지침</h3>
                        <p class="mt-2 text-sm leading-6 text-slate-600">
                            복사되는 지침은 선택한 언어 하나만 포함합니다. 처음 설치할 때만 Agent가 회상 연결 키를 요청하고 전역, 현재 프로젝트, 현재 세션 중 적용 범위를 묻도록 안내합니다.
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-2 text-xs font-semibold">
                        <a class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-700 transition hover:bg-slate-50"
                           href="@SlogsMcpPolicyPrompt.VersionPath"
                           target="_blank">버전 URL</a>
                        <a class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-700 transition hover:bg-slate-50"
                           href="@SlogsMcpPolicyPrompt.KoreanPublicPath"
                           target="_blank">한국어 URL</a>
                        <a class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-700 transition hover:bg-slate-50"
                           href="@SlogsMcpPolicyPrompt.EnglishPublicPath"
                           target="_blank">English URL</a>
                    </div>
                </div>

                <div class="mt-4 grid gap-3 lg:grid-cols-2">
                    <div class="@GetKoreanPromptCardClass()">
                        <div>
                            <p class="text-sm font-bold text-slate-900">한국어 회상 지침</p>
                            <p class="mt-1 text-xs leading-5 text-slate-500">한국어 지침만 포함합니다. 최초 설치 시 Agent 회상 연결 키와 적용 범위를 묻도록 안내합니다.</p>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <button class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100"
                                    type="button"
                                    @onclick="SelectKoreanPrompt">
                                미리보기
                            </button>
                            <button class="rounded-full bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-slate-800"
                                    type="button"
                                    @onclick="CopyKoreanAgentPromptAsync">
                                한국어 복사
                            </button>
                        </div>
                    </div>
                    <div class="@GetEnglishPromptCardClass()">
                        <div>
                            <p class="text-sm font-bold text-slate-900">English Recall Instructions</p>
                            <p class="mt-1 text-xs leading-5 text-slate-500">English instructions only. It asks for the Agent recall connection key and scope only during initial installation.</p>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <button class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100"
                                    type="button"
                                    @onclick="SelectEnglishPrompt">
                                Preview
                            </button>
                            <button class="rounded-full bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-slate-800"
                                    type="button"
                                    @onclick="CopyEnglishAgentPromptAsync">
                                Copy English Instructions
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-4 overflow-hidden rounded-xl border border-slate-300 bg-slate-950 shadow-sm">
                    <div class="flex flex-col gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <p class="text-xs font-bold uppercase text-slate-600">Preview</p>
                            <h4 class="mt-1 text-sm font-bold text-slate-950">@GetSelectedPromptTitle()</h4>
                            <p class="mt-1 break-all text-xs font-semibold text-slate-700">@GetSelectedPromptUrl()</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            @if (!string.IsNullOrWhiteSpace(copyPromptMessage))
                            {
                                <span class="text-xs font-semibold text-emerald-700">@copyPromptMessage</span>
                            }
                            <button class="rounded-full bg-slate-900 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-slate-800"
                                    type="button"
                                    @onclick="CopySelectedAgentPromptAsync">
                                선택한 지침 복사
                            </button>
                        </div>
                    </div>
                    <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words p-4 text-xs leading-5 text-slate-100"><code>@GetSelectedAgentPrompt()</code></pre>
                </div>
            </div>
        </section>
    </section>
}

@code {
    private const string KoreanPromptLanguage = "ko";
    private const string EnglishPromptLanguage = "en";

    private AuthUser? CurrentUser => AuthState.CurrentUser;
    private string selectedPromptLanguage = KoreanPromptLanguage;
    private string copyPromptMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.EnsureInitializedAsync();
        if (CurrentUser is null)
        {
            Navigation.NavigateTo(GetLoginHref());
            return;
        }

        if (CurrentFragment.Equals("search", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/me/llm-wiki/search", replace: true);
        }
    }

    private string CurrentFragment
    {
        get
        {
            var fragment = new Uri(Navigation.Uri).Fragment;
            return string.IsNullOrWhiteSpace(fragment) ? string.Empty : fragment[1..];
        }
    }

    private void SelectKoreanPrompt()
    {
        selectedPromptLanguage = KoreanPromptLanguage;
        copyPromptMessage = string.Empty;
    }

    private void SelectEnglishPrompt()
    {
        selectedPromptLanguage = EnglishPromptLanguage;
        copyPromptMessage = string.Empty;
    }

    private async Task CopySelectedAgentPromptAsync()
        => await CopyPromptTextAsync(GetSelectedAgentPrompt(), GetSelectedCopyMessage());

    private async Task CopyKoreanAgentPromptAsync()
    {
        selectedPromptLanguage = KoreanPromptLanguage;
        await CopyPromptTextAsync(SlogsMcpPolicyPrompt.BuildKoreanMarkdown(), "한국어 회상 지침이 복사되었습니다.");
    }

    private async Task CopyEnglishAgentPromptAsync()
    {
        selectedPromptLanguage = EnglishPromptLanguage;
        await CopyPromptTextAsync(SlogsMcpPolicyPrompt.BuildEnglishMarkdown(), "English recall instructions copied.");
    }

    private string GetSelectedAgentPrompt()
        => selectedPromptLanguage == EnglishPromptLanguage
            ? SlogsMcpPolicyPrompt.BuildEnglishMarkdown()
            : SlogsMcpPolicyPrompt.BuildKoreanMarkdown();

    private string GetSelectedPromptTitle()
        => selectedPromptLanguage == EnglishPromptLanguage
            ? "English Recall Instructions"
            : "한국어 회상 지침";

    private string GetSelectedPromptUrl()
        => selectedPromptLanguage == EnglishPromptLanguage
            ? SlogsMcpPolicyPrompt.DefaultEnglishPublicUrl
            : SlogsMcpPolicyPrompt.DefaultKoreanPublicUrl;

    private string GetSelectedCopyMessage()
        => selectedPromptLanguage == EnglishPromptLanguage
            ? "English recall instructions copied."
            : "한국어 회상 지침이 복사되었습니다.";

    private string GetKoreanPromptCardClass()
        => GetPromptCardClass(KoreanPromptLanguage);

    private string GetEnglishPromptCardClass()
        => GetPromptCardClass(EnglishPromptLanguage);

    private string GetPromptCardClass(string language)
    {
        var isSelected = string.Equals(selectedPromptLanguage, language, StringComparison.Ordinal);
        return isSelected
            ? "rounded-xl border border-slate-900 bg-white p-4 shadow-sm ring-2 ring-slate-900/10"
            : "rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300";
    }

    private async Task CopyPromptTextAsync(string text, string message)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copyPromptMessage = message;
    }

    private string GetLoginHref()
    {
        var uri = new Uri(Navigation.Uri);
        var safeReturn = string.IsNullOrWhiteSpace(uri.Query) ? uri.AbsolutePath : uri.PathAndQuery;
        return $"/login?returnUrl={Uri.EscapeDataString(safeReturn)}";
    }
}
