    private string? GetInferredMenuContext()
    {
        if (CurrentUser is null || post is null || !post.IsAuthor(CurrentUser.UserName))
        {
            return null;
        }

        var segments = new Uri(Navigation.Uri).AbsolutePath
            .Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length != 2 || !segments[0].StartsWith("@", StringComparison.Ordinal))
        {
            return null;
        }

        var author = Uri.UnescapeDataString(segments[0][1..]);
        return author.Equals(CurrentUser.UserName, StringComparison.OrdinalIgnoreCase)
            ? PostNavigationUrlBuilder.PersonalMenuContext
            : null;
    }

