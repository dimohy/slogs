    private async Task DeletePost()
    {
        if (isDeletingPost)
        {
            return;
        }

        if (post is null || CurrentUser is null || !post.IsAuthor(CurrentUser.UserName))
        {
            message = "로그를 지울 권한이 없습니다.";
            showDeleteConfirm = false;
            return;
        }

        isDeletingPost = true;
        message = string.Empty;
        StateHasChanged();

        try
        {
            var deleted = await ApiClient.DeletePostAsync(post.Slug, CurrentUser.UserName);
            if (!deleted)
            {
                showDeleteConfirm = false;
                message = "로그를 지우지 못했습니다.";
                return;
            }

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            showDeleteConfirm = false;
            message = $"로그 지우기 요청 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            isDeletingPost = false;
        }
    }

