@page "/@{Author}/{Slug}"
@page "/post/{Slug}"
@inject SlogsApiClient ApiClient
@inject SlogsAuthState AuthState
@inject NavigationManager Navigation
<PageTitle>@(post?.Title ?? "로그 노드를 찾을 수 없습니다")</PageTitle>
@if (post is null)
{
    <SeoHead Title="로그 노드를 찾을 수 없습니다 | slogs"
             Description="요청한 slogs 로그를 찾을 수 없습니다."
             CanonicalPath="@GetCurrentCanonicalPath()"
             NoIndex="true" />
}
else
{
    <SeoHead Title="@($"{post.Title} | slogs")"
             Description="@post.Summary"
             CanonicalPath="@GetPostUrl(post)"
             Type="article"
             ImageUrl="@GetPostSeoImageUrl(post)"
             Author="@post.Author"
             Tags="@post.Tags"
             PublishedAt="@post.PublishedAt"
             UpdatedAt="@post.UpdatedAt"
             NoIndex="@post.IsDraft"
             JsonLd="@(post.IsDraft ? null : SeoMetadata.ArticleJsonLd(Navigation.BaseUri, post, GetPostUrl(post), GetPostSeoImageUrl(post)))" />
}

@if (post is null)
{
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <h2 class="mb-2 text-xl font-bold text-slate-900">요청한 로그 노드를 찾지 못했습니다.</h2>
        <a class="font-semibold text-slate-800 underline" href="/">지식 로그 홈으로</a>
    </div>
}
else
{
    var heroImageUrl = GetPostHeroImageUrl(post);
    var latestRevisionNumberForNode = revisions.Count > 0 ? revisions.Max(x => x.RevisionNumber) : 1;
    <article class="rounded-2xl border border-slate-200 bg-white p-4">
        @if (!string.IsNullOrWhiteSpace(heroImageUrl))
        {
            <figure class="post-detail-cover mb-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
                <img class="post-detail-cover__image"
                     src="@heroImageUrl"
                     alt="@GetPostHeroImageAltText(post)"
                     loading="eager"
                     decoding="sync"
                     fetchpriority="high" />
            </figure>
        }
        <div class="post-detail-node-strip mb-4">
            <span class="post-detail-node-strip__label">@(post.IsDraft ? "게시전 지식 로그 노드" : "공개 지식 로그 노드")</span>
            <span>출처 @FormatUserName(post.Author)</span>
            <span>@(post.IsDraft ? "게시전 기억" : $"리비전 v{latestRevisionNumberForNode}")</span>
            <span>@($"{relatedPosts.Count} 연결 로그")</span>
            <span>@($"{post.CommentCount} 대화 흔적")</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold text-slate-900">@post.Title</h1>
            @if (post.IsDraft)
            {
                <span class="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">게시전 로그</span>
            }
            else
            {
                <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800">공개 로그</span>
            }
            @if (!post.IsDraft && revisions.Count > 0)
            {
                var orderedRevisions = revisions.OrderByDescending(x => x.RevisionNumber).ToList();
                var latestNumber = orderedRevisions[0].RevisionNumber;
                var selectedNumber = selectedRevisionNumber ?? latestNumber;
                var selectedRevision = orderedRevisions.FirstOrDefault(x => x.RevisionNumber == selectedNumber) ?? orderedRevisions[0];
                var isSelectedLoading = loadingRevisionNumbers.Contains(selectedNumber);
                <div class="ml-auto flex flex-wrap items-center gap-2">
                    <div class="relative">
                        <button type="button"
                                class="flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-1 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                                @onclick="ToggleRevisionMenu">
                            <span>@($"리비전 흐름 v{selectedNumber}")</span>
                            <span class="text-xs font-normal text-slate-400">@FormatDate(selectedRevision.CreatedAt)</span>
                            <span class="text-xs text-slate-400">▾</span>
                        </button>
                        @if (isRevisionMenuOpen)
                        {
                            <button type="button" class="fixed inset-0 z-10 cursor-default" aria-hidden="true" tabindex="-1" @onclick="CloseRevisionMenu"></button>
                            <div class="absolute right-0 z-20 mt-1 max-h-72 w-72 overflow-auto rounded-md border border-slate-200 bg-white p-1 shadow-lg">
                                @foreach (var revision in orderedRevisions)
                                {
                                    var isActive = revision.RevisionNumber == selectedNumber;
                                    <button type="button"
                                            class="@($"flex w-full flex-wrap items-center gap-1.5 rounded px-2 py-1.5 text-left text-sm transition hover:bg-slate-100 {(isActive ? "bg-sky-50" : "")}")"
                                            @onclick="() => SelectRevisionAsync(revision.RevisionNumber)">
                                        <span class="font-bold text-slate-900">@($"v{revision.RevisionNumber}")</span>
                                        <span class="text-xs text-slate-500">@FormatDateTime(revision.CreatedAt)</span>
                                        @foreach (var field in revision.ChangedFields)
                                        {
                                            <span class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-xs font-semibold text-slate-600">@field</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <button class="rounded-md border border-slate-300 bg-white px-3 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-60"
                            disabled="@isSelectedLoading"
                            type="button"
                            @onclick="ShowRevisionDiffAsync">
                        @(isSelectedLoading && revisionView == "diff" ? "불러오는 중..." : revisionView == "diff" ? "흐름 비교 닫기" : "흐름 비교")
                    </button>
                </div>
            }
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <a class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 hover:bg-slate-100" href="/">지식 로그 홈</a>
            <a class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 hover:bg-slate-100" href="@GetPostAuthorUrl()">슬로거 홈</a>
            <a class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 hover:bg-slate-100" href="#comments">대화 흔적으로 이동</a>
            <a class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 hover:bg-slate-100" href="#related-posts">연결 로그 보기</a>
            @if (previousPost is not null)
            {
                <a class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 hover:bg-slate-100"
                   href="@GetPostNavigationUrl(previousPost)">이전 로그 이동</a>
            }
            @if (nextPost is not null)
            {
                <a class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 hover:bg-slate-100"
                   href="@GetPostNavigationUrl(nextPost)">다음 로그 이동</a>
            }
        </div>

        <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <a class="font-semibold text-slate-800 hover:underline"
               href="@($"/@{Uri.EscapeDataString(post.Author)}")">@FormatUserName(post.Author)</a>
            <span>@($"관계 흐름 {authorFollowerCount}개")</span>
            @if (post.IsDraft)
            {
                <span>게시전 로그</span>
                <span>수정 @FormatDateTime(post.UpdatedAt)</span>
            }
            else
            {
                <span class="inline-flex items-center gap-1">
                    <SlogsIcon Name="calendar" Class="h-3.5 w-3.5" />
                    <span>@FormatDate(post.PublishedAt)</span>
                </span>
            }
            <span class="inline-flex items-center gap-1">
                <SlogsIcon Name="clock" Class="h-3.5 w-3.5" />
                <span>@post.ReadTimeMinutes 분</span>
            </span>
            <span class="inline-flex items-center gap-1" title="회상 접근">
                <SlogsIcon Name="eye" Class="h-3.5 w-3.5" />
                <span>@FormatRecallAccessCount(post.ViewCount)</span>
            </span>
            @if (CanFollowAuthor)
            {
                <button class="ml-2 rounded-full border border-slate-300 px-3 py-1 text-sm font-semibold transition hover:bg-slate-100 @(isWriterFollowBusy ? "cursor-wait opacity-60" : "")"
                        disabled="@isWriterFollowBusy"
                        @onclick="ToggleFollowAuthor">
                    @(isFollowingAuthor ? "관계 해제" : "관계 잇기")
                </button>
            }
            else if (CurrentUser is null)
            {
                <a class="ml-2 rounded-full border border-slate-300 px-3 py-1 text-sm font-semibold transition hover:bg-slate-100"
                   href="@GetLoginReturnUrl()">관계 잇기</a>
            }
            @if (post.UpdatedAt > post.PublishedAt.AddMinutes(1))
            {
                <span>수정 @FormatDateTime(post.UpdatedAt)</span>
            }
        </div>

        <div class="post-detail-flowline mt-4" aria-label="로그 노드 흐름 요약">
            <div class="min-w-0">
                <p class="text-xs font-bold text-slate-500">노드 흐름 요약</p>
                <p class="mt-1 text-sm font-semibold text-slate-700">@GetPostNodeFlowDescription(post, latestRevisionNumberForNode)</p>
            </div>
            <div class="post-detail-flowline__signals" aria-label="로그 노드 흐름 신호">
                <span>@GetPrimaryClueSignal(post)</span>
                <span>@GetPrimarySeriesSignal(post)</span>
                <span>@GetRevisionFlowSignal(post, latestRevisionNumberForNode)</span>
                <span>@GetLinkedLogSignal()</span>
            </div>
        </div>

        <p class="mt-3 text-slate-700">@post.Summary</p>

        <div class="mt-3 flex flex-wrap gap-2">
            @foreach (var tag in post.Tags)
            {
                <a class="rounded-full border border-sky-200 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-900 hover:bg-sky-100"
                   href="@($"/tag/{Uri.EscapeDataString(tag)}")">#@tag</a>
            }
        </div>

        @if (!post.IsDraft && revisions.Count > 0 && (revisionView == "diff" || !string.IsNullOrWhiteSpace(revisionMessage)))
        {
            var diffNumber = selectedRevisionNumber ?? revisions.Max(x => x.RevisionNumber);
            var isDiffLoading = loadingRevisionNumbers.Contains(diffNumber);
            var hasDiffDetail = revisionDetails.TryGetValue(diffNumber, out var diffDetail);
            <section id="revisions" class="mt-4 rounded-md border border-slate-200 bg-slate-50 p-3">
                @if (!string.IsNullOrWhiteSpace(revisionMessage))
                {
                    <div class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
                        @revisionMessage
                    </div>
                }
                @if (revisionView == "diff")
                {
                    <div class="@(string.IsNullOrWhiteSpace(revisionMessage) ? "" : "mt-3")">
                        @if (isDiffLoading && !hasDiffDetail)
                        {
                            <p class="text-sm text-slate-500">변경점을 불러오는 중입니다.</p>
                        }
                        else if (diffDetail is null)
                        {
                            <p class="text-sm text-slate-500">변경점을 불러오지 못했습니다.</p>
                        }
                        else if (diffDetail.Diffs.Count == 0)
                        {
                            <p class="text-sm text-slate-500">비교할 변경점이 없습니다.</p>
                        }
                        else
                        {
                            <div class="grid gap-3">
                                @foreach (var diff in diffDetail.Diffs)
                                {
                                    <div class="overflow-hidden rounded-md border border-slate-200">
                                        <div class="border-b border-slate-200 bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-800">@diff.Label</div>
                                        <div class="revision-diff-code max-h-80 overflow-auto py-2 font-mono text-xs leading-relaxed">
                                            @foreach (var line in diff.Lines)
                                            {
                                                <div class="@GetDiffLineClass(line.Kind)">
                                                    <span class="revision-diff-marker">@GetDiffLinePrefix(line.Kind)</span>
                                                    <span class="revision-diff-text">@line.Text</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @{
            var activeRevisionBody = selectedRevisionNumber is int activeRevisionNumber
                && revisionDetails.TryGetValue(activeRevisionNumber, out var activeRevisionDetail)
                ? activeRevisionDetail.Body
                : post.Body;
        }
        <MarkdownPreview Value="@activeRevisionBody" Class="mt-4" />

        <div class="mt-4 flex flex-wrap gap-2">
            @if (!post.IsDraft)
            {
                <PostActionBar Post="post"
                               CurrentUserName="@CurrentUserName"
                               CommentsUrl="#comments"
                               IsLikeBusy="@isLikeBusy"
                               IsBookmarkBusy="@isBookmarkBusy"
                               OnToggleLike="ToggleLikeFromActionBar"
                               OnToggleBookmark="ToggleBookmarkFromActionBar"
                               Class="flex flex-wrap gap-2" />
            }

            @if (CanEditCurrentPost)
            {
                <a class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold transition hover:bg-slate-100" href="@GetEditHref()">@(post.IsDraft ? "게시전 로그 수정" : "새 리비전 남기기")</a>
                <button class="rounded-full border border-rose-300 px-3 py-1.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-50"
                        disabled="@isDeletingPost"
                        type="button" @onclick="ShowDeleteConfirm">
                    @(isDeletingPost ? "로그 지우는 중..." : "로그 지우기")
                </button>
            }
        </div>
        @if (showDeleteConfirm)
        {
            <div class="mt-3 flex flex-col gap-2 rounded-xl border border-rose-200 bg-rose-50 p-3">
                <p class="text-sm font-semibold text-rose-900">이 로그 흐름을 지울까요?</p>
                <div class="flex flex-wrap gap-2">
                    <button class="rounded-full border border-rose-300 bg-rose-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-rose-700"
                            disabled="@isDeletingPost"
                            type="button" @onclick="DeletePost">
                        @(isDeletingPost ? "로그 지우는 중..." : "로그 지우기 진행")
                    </button>
                    <button class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold transition hover:bg-slate-100"
                            disabled="@isDeletingPost"
                            type="button" @onclick="CancelDelete">
                        취소
                    </button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
                @message
            </div>
        }
    </article>

    <section id="related-posts" class="mt-4 rounded-2xl border border-slate-200 bg-white p-4">
        <h3 class="mb-3 text-lg font-bold text-slate-900">연결된 로그</h3>
        @if (relatedPosts.Count > 0)
        {
            <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
                @for (var index = 0; index < relatedPosts.Count; index++)
                {
                    var item = relatedPosts[index];
            <article class="clickable-post-card post-detail-linked-card rounded-2xl border border-slate-200 bg-white p-3"
                     data-card-click-href="@GetPostNavigationUrl(item)"
                     tabindex="0"
                     role="link"
                     aria-label="@($"{item.Title} 연결 로그 열기")">
                <PostCardImage Post="item" PostUrl="@GetPostNavigationUrl(item)" Priority="@IsPriorityCardImage(index)" />
                <PostFlowSignals Post="item" Class="post-log-card__signals post-detail-linked-card__signals" />
                <a class="mb-2 block text-base font-bold text-slate-800 hover:underline" href="@GetPostNavigationUrl(item)">@item.Title</a>
                @if (!string.IsNullOrWhiteSpace(item.Summary))
                {
                    <p class="post-detail-linked-card__summary text-sm leading-5 text-slate-600">@Shorten(item.Summary, 110)</p>
                }
                <PostMetaLine Post="item" Class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-500" ShowReadTime="false" ShowViews="false" ShowSeries="false" />
            </article>
                }
            </div>
        }
        else
        {
            <p class="text-sm text-slate-500">연결된 로그가 없습니다.</p>
        }
    </section>

    @if (previousPost is not null || nextPost is not null)
    {
        <section class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
            <article class="clickable-post-card rounded-2xl border border-slate-200 bg-white p-4"
                     data-card-click-href="@(previousPost is null ? null : GetPostNavigationUrl(previousPost))"
                     tabindex="@(previousPost is null ? null : "0")"
                     role="@(previousPost is null ? null : "link")"
                     aria-label="@(previousPost is null ? null : $"{previousPost.Title} 이전 로그 열기")">
                <p class="text-xs font-semibold text-slate-500">이전 로그</p>
                @if (previousPost is null)
                {
                    <p class="mt-2 text-sm text-slate-500">이전 로그가 없습니다.</p>
                }
                else
                {
                    <PostFlowSignals Post="previousPost" Class="post-log-card__signals post-detail-linked-card__signals" />
                    <a class="mt-2 block text-lg font-bold text-slate-900 transition hover:underline" href="@GetPostNavigationUrl(previousPost)">
                        @previousPost.Title
                    </a>
                    @if (!string.IsNullOrWhiteSpace(previousPost.Summary))
                    {
                        <p class="post-detail-linked-card__summary mt-2 text-sm leading-5 text-slate-600">@Shorten(previousPost.Summary, 130)</p>
                    }
                    <a class="mt-1 block text-sm text-slate-500 hover:underline" href="@GetWriterUrl(previousPost.Author)">@FormatUserName(previousPost.Author)</a>
                }
            </article>

            <article class="clickable-post-card rounded-2xl border border-slate-200 bg-white p-4"
                     data-card-click-href="@(nextPost is null ? null : GetPostNavigationUrl(nextPost))"
                     tabindex="@(nextPost is null ? null : "0")"
                     role="@(nextPost is null ? null : "link")"
                     aria-label="@(nextPost is null ? null : $"{nextPost.Title} 다음 로그 열기")">
                <p class="text-xs font-semibold text-slate-500">다음 로그</p>
                @if (nextPost is null)
                {
                    <p class="mt-2 text-sm text-slate-500">다음 로그가 없습니다.</p>
                }
                else
                {
                    <PostFlowSignals Post="nextPost" Class="post-log-card__signals post-detail-linked-card__signals" />
                    <a class="mt-2 block text-lg font-bold text-slate-900 transition hover:underline" href="@GetPostNavigationUrl(nextPost)">
                        @nextPost.Title
                    </a>
                    @if (!string.IsNullOrWhiteSpace(nextPost.Summary))
                    {
                        <p class="post-detail-linked-card__summary mt-2 text-sm leading-5 text-slate-600">@Shorten(nextPost.Summary, 130)</p>
                    }
                    <a class="mt-1 block text-sm text-slate-500 hover:underline" href="@GetWriterUrl(nextPost.Author)">@FormatUserName(nextPost.Author)</a>
                }
            </article>
        </section>
    }

    <section id="comments" class="mt-4 rounded-2xl border border-slate-200 bg-white p-4">
        <h3 class="mb-3 text-lg font-bold text-slate-900">대화 흔적 흐름 (@post.CommentCount)</h3>

        @if (CurrentUser is null)
        {
            <p class="text-sm text-slate-500">이 로그 노드에 대화 흔적을 남기려면 <a class="font-semibold underline" href="@GetLoginReturnUrl()">로그인</a>해 주세요.</p>
        }
        else
        {
            <div class="mt-2 flex flex-col gap-2">
                <div class="text-right text-xs text-slate-500">@($"{newComment?.Length ?? 0}/1000")</div>
                <div class="comment-compose">
                    <textarea class="comment-compose__input rounded-2xl border border-slate-300 p-3 text-sm"
                              disabled="@isCommentSaving"
                              rows="4" maxlength="1000" @bind="newComment" @bind:event="oninput"
                              @onkeydown="HandleCommentKeyDown" placeholder="이 로그 노드에 이어질 대화 흔적을 남겨주세요"></textarea>
                    <button class="comment-compose__submit rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60"
                            @onclick="SubmitComment" disabled="@(!CanSubmitComment)">
                        흔적 남기기
                    </button>
                </div>
            </div>
        }

        @if (!post.Comments.Any())
        {
            <p class="mt-3 text-sm text-slate-500">아직 이어진 대화 흔적이 없습니다. 첫 흐름을 남겨 보세요.</p>
        }
        else
        {
            <div class="mt-2 flex flex-wrap gap-2 text-sm">
                <a class="@GetCommentSortChipClass("latest")" href="@GetCommentSortHref("latest")">최근 흔적</a>
                <a class="@GetCommentSortChipClass("oldest")" href="@GetCommentSortHref("oldest")">처음 흔적</a>
            </div>

            @if (commentTotalCount > 0)
            {
                <p class="mt-1 text-xs text-slate-500">@($"흐름 기준: {GetCommentSortLabel(commentSortOrder)} · 대화 흔적 {commentTotalCount}개")</p>
            }
            <div class="mt-3 flex flex-col gap-2">
                @foreach (var comment in topLevelComments)
                {
                    <article class="rounded-xl border-t border-slate-200 pt-2">
                        <div class="flex flex-wrap items-center gap-1 text-sm text-slate-500">
                            <a class="hover:underline" href="@GetCommentAuthorUrl(comment)">@FormatUserName(comment.Author)</a>
                            <span>·</span>
                            <span>@FormatDateTime(comment.CreatedAt)</span>
                            @if (CurrentUser is not null)
                            {
                                <span>·</span>
                                <button class="text-slate-700 transition hover:text-slate-900" type="button" disabled="@isCommentSaving" @onclick="() => StartReply(comment.Id)">
                                    대화 잇기
                                </button>
                            }
                            @if (CanEditComment(comment))
                            {
                                <span>·</span>
                                <button class="text-slate-700 transition hover:text-slate-900" type="button" disabled="@isCommentSaving" @onclick="() => StartEditComment(comment.Id)">
                                    흔적 다듬기
                                </button>
                            }
                            @if (CanDeleteComment(comment))
                            {
                                <span>·</span>
                                <button class="text-rose-600 transition hover:text-rose-700" type="button" disabled="@isCommentSaving" @onclick="() => RequestDeleteComment(comment.Id)">
                                    흔적 지우기
                                </button>
                            }
                        </div>

                        @if (pendingDeleteCommentId == comment.Id)
                        {
                            <div class="mt-2 rounded-lg border border-rose-200 bg-rose-50 p-2 text-sm text-rose-800">
                                <p class="mb-2">이 대화 흔적을 지울까요?</p>
                                <div class="flex flex-wrap gap-2">
                                    <button class="rounded-full border border-rose-300 bg-rose-600 px-3 py-1 text-xs font-semibold text-white transition hover:bg-rose-700"
                                            type="button" disabled="@isCommentSaving" @onclick="ConfirmDeleteComment">
                                        흔적 지우기
                                    </button>
                                    <button class="rounded-full border border-slate-300 px-3 py-1 text-xs font-semibold transition hover:bg-slate-100"
                                            type="button" @onclick="CancelDeleteComment">
                                        취소
                                    </button>
                                </div>
                            </div>
                        }

                        @if (editingCommentId == comment.Id)
                        {
                            <textarea class="mt-1 min-h-20 w-full rounded-xl border border-slate-300 p-3 text-sm"
                                      disabled="@isCommentSaving"
                                      rows="3" maxlength="1000" @bind="editingCommentText" @bind:event="oninput"
                                      @onkeydown="(e) => HandleEditKeyDown(e, comment.Id)"></textarea>
                            <div class="mt-1 text-right text-xs text-slate-500">@($"{editingCommentText?.Length ?? 0}/1000")</div>
                            <div class="mt-2 flex flex-wrap gap-2">
                                <button class="rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60"
                                        type="button" @onclick="() => SubmitEditComment(comment.Id)"
                                        disabled="@(string.IsNullOrWhiteSpace(editingCommentText) || isCommentSaving)">
                                    흔적 갱신
                                </button>
                                <button class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                                        type="button" @onclick="CancelEditComment">
                                    취소
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="mt-1 text-slate-700">@comment.Content</p>
                            @if (comment.IsEdited)
                            {
                                <p class="text-xs text-slate-400">흔적 갱신됨</p>
                            }
                        }
                    </article>
                    @if (replyingToCommentId == comment.Id)
                    {
                        <div class="mt-2 rounded-2xl border border-slate-300 bg-slate-50 p-3">
                            <p class="mb-1 text-xs text-slate-500">[@FormatUserName(comment.Author)] 대화 흔적에 이어 남기기</p>
                            <div class="text-right text-xs text-slate-500">@($"{replyComment?.Length ?? 0}/1000")</div>
                            <textarea class="min-h-20 w-full rounded-xl border border-slate-300 p-3 text-sm"
                                      disabled="@isCommentSaving"
                                      rows="3" maxlength="1000" @bind="replyComment" @bind:event="oninput"
                                      placeholder="대화 흔적에 이어 남겨주세요"
                                      @onkeydown="(e) => HandleReplyKeyDown(e, comment.Id)"></textarea>
                            <div class="mt-2 flex flex-wrap gap-2">
                                <button class="rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60"
                                        type="button" @onclick="() => SubmitReply(comment.Id)" disabled="@(string.IsNullOrWhiteSpace(replyComment) || isCommentSaving)">
                                    대화 잇기
                                </button>
                                <button class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                                        type="button" @onclick="CancelReply">
                                    취소
                                </button>
                            </div>
                        </div>
                    }

                    @foreach (var reply in GetReplies(comment.Id))
                    {
                        <article class="ml-6 rounded-xl border-l-2 border-slate-200 pl-3 pt-2">
                            <div class="flex flex-wrap items-center gap-1 text-sm text-slate-500">
                                <a class="hover:underline" href="@GetCommentAuthorUrl(reply)">@FormatUserName(reply.Author)</a>
                                <span>·</span>
                                <span>@FormatDateTime(reply.CreatedAt)</span>
                            @if (CanDeleteComment(reply))
                            {
                                <span>·</span>
                                    <button class="text-rose-600 transition hover:bg-rose-200 hover:text-rose-700" type="button" disabled="@isCommentSaving" @onclick="() => RequestDeleteComment(reply.Id)">
                                    흔적 지우기
                                </button>
                            }
                            @if (CanEditComment(reply))
                            {
                                <span>·</span>
                                    <button class="text-slate-700 transition hover:bg-slate-100 hover:text-slate-900" type="button" disabled="@isCommentSaving" @onclick="() => StartEditComment(reply.Id)">
                                    흔적 다듬기
                                </button>
                            }
                            </div>

                            @if (pendingDeleteCommentId == reply.Id)
                            {
                                <div class="mt-2 rounded-lg border border-rose-200 bg-rose-50 p-2 text-sm text-rose-800">
                                    <p class="mb-2">이 이어진 대화 흔적을 지울까요?</p>
                                    <div class="flex flex-wrap gap-2">
                                        <button class="rounded-full border border-rose-300 bg-rose-600 px-3 py-1 text-xs font-semibold text-white transition hover:bg-rose-700"
                                                type="button" @onclick="ConfirmDeleteComment">
                                            흔적 지우기
                                        </button>
                                        <button class="rounded-full border border-slate-300 px-3 py-1 text-xs font-semibold transition hover:bg-slate-100"
                                                type="button" @onclick="CancelDeleteComment">
                                            취소
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (editingCommentId == reply.Id)
                            {
                                <textarea class="mt-1 min-h-20 w-full rounded-xl border border-slate-300 p-3 text-sm"
                                          disabled="@isCommentSaving"
                                          rows="3" maxlength="1000" @bind="editingCommentText" @bind:event="oninput"
                                          @onkeydown="(e) => HandleEditKeyDown(e, reply.Id)"></textarea>
                                <div class="mt-1 text-right text-xs text-slate-500">@($"{editingCommentText?.Length ?? 0}/1000")</div>
                                <div class="mt-2 flex flex-wrap gap-2">
                                    <button class="rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60"
                                            type="button" @onclick="() => SubmitEditComment(reply.Id)"
                                            disabled="@(string.IsNullOrWhiteSpace(editingCommentText) || isCommentSaving)">
                                        흔적 갱신
                                    </button>
                                    <button class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                                            type="button" @onclick="CancelEditComment">
                                        취소
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="mt-1 text-slate-700">@reply.Content</p>
                                @if (reply.IsEdited)
                                {
                                    <p class="text-xs text-slate-400">흔적 갱신됨</p>
                                }
                            }
                        </article>
                    }
                }
            </div>

            <InfiniteScrollSentinel Visible="@(topLevelComments.Count > 0)"
                                    HasMore="@HasMoreComments"
                                    IsLoading="@isLoadingMoreComments"
                                    OnLoadMore="LoadMoreCommentsAsync"
                                    ShowDoneText="@(allTopLevelComments.Count > CommentPageSize)"
                                    DoneText="모든 대화 흔적 흐름을 불러왔습니다." />
        }
    </section>
}

@code {
    [Parameter] public string Author { get; set; } = string.Empty;
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter, SupplyParameterFromQuery(Name = "commentOrder")]
    public string? CommentOrderQuery { get; set; }

    private string newComment = string.Empty;
    private string replyComment = string.Empty;
    private string editingCommentText = string.Empty;
    private BlogPost? post;
    private string? loadedPostSlug;
    private IReadOnlyList<BlogComment> topLevelComments = Array.Empty<BlogComment>();
    private IReadOnlyList<BlogComment> allTopLevelComments = Array.Empty<BlogComment>();
    private int commentCurrentPage = 1;
    private int commentTotalPages = 1;
    private int commentTotalCount;
    private string commentSortOrder = "latest";
    private IReadOnlyList<BlogPost> relatedPosts = Array.Empty<BlogPost>();
    private IReadOnlyList<PostRevisionSummaryResponse> revisions = Array.Empty<PostRevisionSummaryResponse>();
    private readonly Dictionary<int, PostRevisionResponse> revisionDetails = [];
    private readonly HashSet<int> loadingRevisionNumbers = [];
    private int? selectedRevisionNumber;
    private bool isRevisionMenuOpen;
    private string revisionView = "none";
    private string revisionMessage = string.Empty;
    private BlogPost? previousPost;
    private BlogPost? nextPost;
    private string message = string.Empty;
    private bool showDeleteConfirm;
    private bool isDeletingPost;
    private Guid? pendingDeleteCommentId;
    private Guid? replyingToCommentId;
    private Guid? editingCommentId;
    private bool isLikeBusy;
    private bool isBookmarkBusy;
    private bool isCommentSaving;
    private bool isLoadingMoreComments;
    private Guid? activeCommentActionCommentId;
    private CommentActionKind activeCommentActionKind = CommentActionKind.None;
    private int authorFollowerCount;
    private bool isFollowingAuthor;
    private bool isWriterFollowBusy;
    private string currentStateKey = string.Empty;

    [PersistentState]
    public PostDetailsPageState? PrerenderedState { get; set; }

    private AuthUser? CurrentUser => AuthState.CurrentUser;
    private string CurrentUserName => CurrentUser?.UserName ?? string.Empty;
    private string CurrentUserDisplayName => CurrentUser?.DisplayName ?? CurrentUserName;
    private bool CanSubmitComment => CurrentUser is not null
        && !isCommentSaving
        && !string.IsNullOrWhiteSpace(newComment)
        && newComment!.Trim().Length <= MaxCommentLength;
    private bool HasMoreComments => topLevelComments.Count < allTopLevelComments.Count;

    private enum CommentActionKind
    {
        None,
        CreateTopLevelComment,
        CreateReplyComment,
        EditComment,
        DeleteComment
    }

    private bool CanStartCommentAction => !isCommentSaving;

    private bool TryBeginCommentAction(CommentActionKind actionKind, Guid? commentId = null)
    {
        if (isCommentSaving)
        {
            message = "현재 대화 흔적 작업이 진행 중입니다. 잠시 후 다시 시도해 주세요.";
            return false;
        }

        isCommentSaving = true;
        activeCommentActionKind = actionKind;
        activeCommentActionCommentId = commentId;
        return true;
    }

    private void EndCommentAction()
    {
        isCommentSaving = false;
        activeCommentActionKind = CommentActionKind.None;
        activeCommentActionCommentId = null;
    }

    private IEnumerable<BlogComment> GetReplies(Guid commentId)
    {
        return post is null
            ? []
            : post.Comments
                .Where(c => c.ParentCommentId == commentId)
                .OrderBy(c => c.CreatedAt)
                .ToArray();
    }

    private BlogComment? FindComment(Guid commentId) => post?.Comments.FirstOrDefault(x => x.Id == commentId);

    private void ResetNewComment()
    {
        newComment = string.Empty;
    }

    private void StartReply(Guid parentCommentId)
    {
        if (!CanStartCommentAction)
        {
            message = "대화 흔적 작업이 진행 중입니다. 잠시 후 다시 시도해 주세요.";
            return;
        }

        if (CurrentUser is null)
        {
            NavigateToLogin();
            return;
        }

        if (post is null || post.Comments.All(x => x.Id != parentCommentId))
        {
            message = "이어갈 대화 흔적을 찾을 수 없습니다.";
            return;
        }

        replyingToCommentId = parentCommentId;
        replyComment = string.Empty;
        pendingDeleteCommentId = null;
        editingCommentId = null;
        editingCommentText = string.Empty;
        message = string.Empty;
    }

    private void CancelReply()
    {
        replyingToCommentId = null;
        replyComment = string.Empty;
    }

    private void StartEditComment(Guid commentId)
    {
        if (!CanStartCommentAction)
        {
            message = "대화 흔적 작업이 진행 중입니다. 잠시 후 다시 시도해 주세요.";
            return;
        }

        if (CurrentUser is null || post is null)
        {
            return;
        }

        var target = FindComment(commentId);
        if (target is null)
        {
            message = "대화 흔적을 찾을 수 없습니다.";
            return;
        }

        if (!CanEditComment(target))
        {
            message = "대화 흔적을 다듬을 권한이 없습니다.";
            return;
        }

        editingCommentId = commentId;
        editingCommentText = target.Content;
        replyingToCommentId = null;
        replyComment = string.Empty;
        pendingDeleteCommentId = null;
        message = string.Empty;
    }

    private void CancelEditComment()
    {
        editingCommentId = null;
        editingCommentText = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        commentSortOrder = NormalizeCommentSortOrder(CommentOrderQuery);
        currentStateKey = PageStateKeyBuilder.FromNavigation(Navigation);
        var restoredPrerenderedState = TryRestorePrerenderedState(currentStateKey);

        var shouldIncrementView = !string.Equals(loadedPostSlug, Slug, StringComparison.OrdinalIgnoreCase);
        if (!restoredPrerenderedState)
        {
            post = shouldIncrementView
                ? await ApiClient.GetBySlugForReadAsync(Slug)
                : await ApiClient.GetBySlugAsync(Slug);
        }

        await AuthState.EnsureInitializedAsync();

        if (restoredPrerenderedState)
        {
            return;
        }

        showDeleteConfirm = false;
        pendingDeleteCommentId = null;
        replyingToCommentId = null;
        replyComment = string.Empty;
        editingCommentId = null;
        editingCommentText = string.Empty;
        if (post is null)
        {

            message = "요청한 로그를 찾을 수 없습니다.";
            authorFollowerCount = 0;
            isFollowingAuthor = false;
            revisions = Array.Empty<PostRevisionSummaryResponse>();
            ClearRevisionDetailState();
            topLevelComments = Array.Empty<BlogComment>();
            allTopLevelComments = Array.Empty<BlogComment>();
            commentCurrentPage = 1;
            commentTotalPages = 1;
            commentTotalCount = 0;
            isLoadingMoreComments = false;
            loadedPostSlug = null;
            CapturePrerenderedState(currentStateKey);
            return;
        }

        // `/post/{slug}` 경로로 직접 접근했더라도 별도 리디렉션 없이 같은 페이지에서 렌더링을 완료한다.
        if (!string.IsNullOrWhiteSpace(Author) && !post.IsAuthor(Author))
        {

            message = "요청한 슬로거와 로그의 출처가 일치하지 않습니다.";
            post = null;
            relatedPosts = Array.Empty<BlogPost>();
            revisions = Array.Empty<PostRevisionSummaryResponse>();
            ClearRevisionDetailState();
            previousPost = null;
            nextPost = null;
            authorFollowerCount = 0;
            isFollowingAuthor = false;
            topLevelComments = Array.Empty<BlogComment>();
            allTopLevelComments = Array.Empty<BlogComment>();
            commentCurrentPage = 1;
            commentTotalPages = 1;
            commentTotalCount = 0;
            isLoadingMoreComments = false;
            loadedPostSlug = null;
            CapturePrerenderedState(currentStateKey);
            return;
        }

        loadedPostSlug = post.Slug;
        if (post.IsDraft)
        {
            relatedPosts = Array.Empty<BlogPost>();
            revisions = Array.Empty<PostRevisionSummaryResponse>();
            ClearRevisionDetailState();
            previousPost = null;
            nextPost = null;
            authorFollowerCount = await ApiClient.GetFollowerCountAsync(post.Author);
            isFollowingAuthor = false;
            message = string.Empty;
            LoadCommentPage();
            CapturePrerenderedState(currentStateKey);
            return;
        }

        relatedPosts = await ApiClient.GetRelatedPostsAsync(Slug, 3);
        revisions = await ApiClient.GetPostRevisionsAsync(Slug);
        ClearRevisionDetailState();
        var adjacent = await ApiClient.GetAdjacentPostsAsync(Slug);
        previousPost = adjacent.Previous;
        nextPost = adjacent.Next;
        authorFollowerCount = await ApiClient.GetFollowerCountAsync(post.Author);
        isFollowingAuthor = CurrentUser is not null
            ? await ApiClient.IsFollowingAsync(CurrentUserName, post.Author)
            : false;
        message = string.Empty;

        if (relatedPosts.Count == 0)
        {
            var byAuthor = await ApiClient.GetByAuthorAsync(post.Author);
            relatedPosts = byAuthor.Where(x => x.Id != post.Id).Take(3).ToArray();
        }
        LoadCommentPage();
        CapturePrerenderedState(currentStateKey);
    }

    private async Task ToggleLike()
    {
        message = string.Empty;
        if (CurrentUser is null)
        {
            message = "공감은 로그인 후 이용 가능합니다.";
            NavigateToLogin();
            return;
        }

        if (post is null)
        {
            message = "요청한 로그를 찾을 수 없습니다.";
            return;
        }

        if (post.IsDraft)
        {
            message = "게시전 로그는 공개 후 공감을 사용할 수 있습니다.";
            return;
        }

        if (isLikeBusy)
        {
            message = "공감이 처리 중입니다. 잠시 후 다시 시도해 주세요.";
            return;
        }

        var wasLiked = post.IsLikedBy(CurrentUserName);
        isLikeBusy = true;
        try
        {
            var newLiked = await ApiClient.ToggleLikeAsync(Slug, CurrentUserName);
            if (wasLiked == newLiked)
            {
                message = "공감을 반영할 수 없습니다. 잠시 후 다시 시도해 주세요.";
                return;
            }

            message = wasLiked
                ? "공감이 취소되었습니다."
                : "공감이 추가되었습니다.";
            await RefreshPostAsync();
        }
        finally
        {
            isLikeBusy = false;
        }
    }

    private Task ToggleLikeFromActionBar(string _)
        => ToggleLike();

    private async Task ToggleBookmark()
    {
        message = string.Empty;
        if (CurrentUser is null)
        {
            message = "저장은 로그인 후 이용 가능합니다.";
            NavigateToLogin();
            return;
        }

        if (post is null)
        {
            message = "요청한 로그를 찾을 수 없습니다.";
            return;
        }

        if (post.IsDraft)
        {
            message = "게시전 로그는 공개 후 저장할 수 있습니다.";
            return;
        }

        if (isBookmarkBusy)
        {
            message = "저장이 처리 중입니다. 잠시 후 다시 시도해 주세요.";
            return;
        }

        var wasBookmarked = post.IsBookmarkedBy(CurrentUserName);
        isBookmarkBusy = true;
        try
        {
            var newBookmarkState = await ApiClient.ToggleBookmarkAsync(Slug, CurrentUserName);
            if (wasBookmarked == newBookmarkState)
            {
                message = "저장을 반영할 수 없습니다. 잠시 후 다시 시도해 주세요.";
                return;
            }

            message = wasBookmarked
                ? "저장이 해제되었습니다."
                : "저장되었습니다.";
            await RefreshPostAsync();
        }
        finally
        {
            isBookmarkBusy = false;
        }
    }

    private Task ToggleBookmarkFromActionBar(string _)
        => ToggleBookmark();

    private async Task SubmitComment()
    {
        if (isCommentSaving)
        {
            return;
        }

        if (CurrentUser is null || post is null || string.IsNullOrWhiteSpace(newComment))
        {
            if (CurrentUser is null)
            {
                message = "대화 흔적은 로그인 후 이용 가능합니다.";
                NavigateToLogin();
                return;
            }

            if (post is null)
            {
                message = "대화 흔적을 남길 수 없습니다.";
                return;
            }

            if (string.IsNullOrWhiteSpace(newComment))
            {
                message = "대화 흔적 내용을 입력해 주세요.";
                return;
            }
        }

        var trimmedComment = newComment.Trim();
        if (trimmedComment.Length > 1000)
        {
            message = "대화 흔적은 1000자 이하로 입력해 주세요.";
            return;
        }

        if (!TryBeginCommentAction(CommentActionKind.CreateTopLevelComment))
        {
            return;
        }

        try
        {
            var comment = await ApiClient.AddCommentAsync(Slug, CurrentUser.UserName, CurrentUserDisplayName, trimmedComment);
            if (comment is null)
            {
                message = "대화 흔적을 남기지 못했습니다.";
                return;
            }

            if (comment.ParentCommentId is not null)
            {
                message = "대화 흔적을 남기지 못했습니다.";
                return;
            }

            newComment = string.Empty;
            await RefreshPostAsync();
            message = "대화 흔적이 남겨졌습니다.";
        }
        finally
        {
            EndCommentAction();
        }
    }

    private async Task SubmitReply(Guid parentCommentId)
    {
        if (isCommentSaving)
        {
            return;
        }

        if (CurrentUser is null || post is null || string.IsNullOrWhiteSpace(replyComment))
        {
            if (CurrentUser is null)
            {
                message = "대화 흔적은 로그인 후 이용 가능합니다.";
                NavigateToLogin();
                return;
            }

            if (post is null)
            {
                message = "대화 흔적을 남길 수 없습니다.";
                return;
            }

            message = "이어 남길 대화 흔적을 입력해 주세요.";
            return;
        }

        var trimmedReply = replyComment.Trim();
        if (trimmedReply.Length > MaxCommentLength)
        {
            message = "대화 흔적은 1000자 이하로 입력해 주세요.";
            return;
        }

        if (post is null || !post.Comments.Any(x => x.Id == parentCommentId))
        {
            message = "이어갈 대화 흔적을 찾을 수 없습니다.";
            return;
        }

        if (!TryBeginCommentAction(CommentActionKind.CreateReplyComment, parentCommentId))
        {
            return;
        }

        try
        {
            var comment = await ApiClient.AddCommentAsync(Slug, CurrentUser.UserName, CurrentUserDisplayName, trimmedReply, parentCommentId);
            if (comment is null)
            {
                message = "이어진 대화 흔적을 남기지 못했습니다.";
                return;
            }

            replyComment = string.Empty;
            replyingToCommentId = null;
            await RefreshPostAsync();
            message = "대화 흔적이 이어졌습니다.";
        }
        finally
        {
            EndCommentAction();
        }
    }

    private async Task SubmitEditComment(Guid commentId)
    {
        if (isCommentSaving)
        {
            return;
        }

        if (CurrentUser is null || post is null)
        {
            message = "대화 흔적을 다듬을 수 없습니다.";
            NavigateToLogin();
            return;
        }

        if (string.IsNullOrWhiteSpace(editingCommentText))
        {
            message = "대화 흔적 내용을 입력해 주세요.";
            return;
        }

        var trimmed = editingCommentText.Trim();
        if (trimmed.Length > MaxCommentLength)
        {
            message = "대화 흔적은 1000자 이하로 입력해 주세요.";
            return;
        }

        var target = FindComment(commentId);
        if (target is null)
        {
            message = "대화 흔적을 찾을 수 없습니다.";
            return;
        }

        if (!CanEditComment(target))
        {
            message = "대화 흔적을 다듬을 권한이 없습니다.";
            return;
        }

        if (!TryBeginCommentAction(CommentActionKind.EditComment, commentId))
        {
            return;
        }

        try
        {
            var updated = await ApiClient.UpdateCommentAsync(Slug, commentId, CurrentUser.UserName, trimmed);
            if (!updated)
            {
                message = "대화 흔적을 갱신하지 못했습니다.";
                return;
            }

            editingCommentId = null;
            editingCommentText = string.Empty;
            await RefreshPostAsync();
            message = "대화 흔적이 갱신되었습니다.";
        }
        finally
        {
            EndCommentAction();
        }
    }

