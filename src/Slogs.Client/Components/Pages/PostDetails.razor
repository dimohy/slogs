    private async Task RefreshPostAsync()
    {
        post = await ApiClient.GetBySlugAsync(Slug);
        if (post is null)
        {
            previousPost = null;
            nextPost = null;
            revisions = Array.Empty<PostRevisionSummaryResponse>();
            ClearRevisionDetailState();
            topLevelComments = Array.Empty<BlogComment>();
            allTopLevelComments = Array.Empty<BlogComment>();
            commentCurrentPage = 1;
            commentTotalPages = 1;
            commentTotalCount = 0;
            isLoadingMoreComments = false;
            loadedPostSlug = null;
            CapturePrerenderedState(currentStateKey);
            return;
        }

        loadedPostSlug = post.Slug;
        revisions = post.IsDraft ? Array.Empty<PostRevisionSummaryResponse>() : await ApiClient.GetPostRevisionsAsync(Slug);
        ClearRevisionDetailState();
        var adjacent = await ApiClient.GetAdjacentPostsAsync(Slug);
        previousPost = adjacent.Previous;
        nextPost = adjacent.Next;
        authorFollowerCount = await ApiClient.GetFollowerCountAsync(post.Author);
        isFollowingAuthor = CurrentUser is not null
            ? await ApiClient.IsFollowingAsync(CurrentUserName, post.Author)
            : false;
        LoadCommentPage(Math.Max(topLevelComments.Count, CommentPageSize));
        CapturePrerenderedState(currentStateKey);
        StateHasChanged();
    }

