    private async Task<PostRevisionResponse?> EnsureRevisionDetailAsync(int revisionNumber)
    {
        if (revisionDetails.TryGetValue(revisionNumber, out var loadedRevision))
        {
            return loadedRevision;
        }

        if (loadingRevisionNumbers.Contains(revisionNumber))
        {
            return null;
        }

        loadingRevisionNumbers.Add(revisionNumber);
        try
        {
            var revision = await ApiClient.GetPostRevisionAsync(Slug, revisionNumber);
            if (revision is null)
            {
                revisionMessage = "요청한 리비전을 찾지 못했습니다.";
                return null;
            }

            revisionDetails[revisionNumber] = revision;
            return revision;
        }
        finally
        {
            loadingRevisionNumbers.Remove(revisionNumber);
            StateHasChanged();
        }
    }

    private void ClearRevisionDetailState()
    {
        revisionDetails.Clear();
        loadingRevisionNumbers.Clear();
        selectedRevisionNumber = null;
        isRevisionMenuOpen = false;
        revisionView = "none";
        revisionMessage = string.Empty;
    }

