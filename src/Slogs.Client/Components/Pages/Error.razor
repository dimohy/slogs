@page "/Error"
@using System.Diagnostics

<PageTitle>요청을 처리하지 못했습니다</PageTitle>
<SeoHead Title="요청을 처리하지 못했습니다 | slogs" Description="요청한 slogs 내용을 잠시 이어가지 못했습니다. 지식 로그 홈, 새 로그, 의미 검색으로 다시 연결합니다." NoIndex="true" />

<div class="rounded-2xl border border-slate-200 bg-white p-6">
    <p class="mb-3 inline-flex rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">목록 중단</p>
    <h1 class="text-2xl font-bold text-slate-900">요청을 처리하지 못했습니다.</h1>
    <p class="mt-2 text-sm text-slate-600">일시적으로 기억, 로그, 태그를 불러오지 못했습니다. 아래 경로에서 다시 이어갈 수 있습니다.</p>

    <div class="mt-4 flex flex-wrap gap-2">
        <a class="rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-slate-800"
           href="/">지식 로그 홈</a>
        <a class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-800 transition hover:bg-slate-100"
           href="/write">새 로그 남기기</a>
        <a class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-800 transition hover:bg-slate-100"
           href="/me/llm-wiki/search">의미 검색</a>
        <a class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-800 transition hover:bg-slate-100"
           href="/me">내 지식 로그</a>
    </div>
</div>

@if (ShowRequestId)
{
    <p class="mt-4 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
        <strong>추적 ID:</strong> <code>@RequestId</code>
    </p>
}

@code {
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id;
}


