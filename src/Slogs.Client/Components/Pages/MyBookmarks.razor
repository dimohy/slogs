@page "/me/bookmarks"
@inject SlogsAuthState AuthState
@inject SlogsApiClient ApiClient
@inject NavigationManager Navigation
<PageTitle>저장 로그</PageTitle>
<SeoHead Title="저장 로그 | slogs" Description="내가 저장한 slogs 로그를 다시 확인합니다." NoIndex="true" />

@if (CurrentUser is null)
{
    <p class="rounded-2xl border border-slate-200 bg-white p-4 text-slate-500">로그인이 필요합니다. <a class="font-semibold underline" href="@GetLoginHref()">로그인</a>해 주세요.</p>
}
else
{
    <div class="border-b border-slate-200 pb-4">
        <h1 class="text-2xl font-bold text-slate-900">저장 로그</h1>
        <p class="mt-1 text-sm text-slate-500">다시 이어 읽을 로그를 모아봅니다.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="mt-3 rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm text-sky-800">@message</p>
    }

    <section class="slogs-post-list-grid mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
        @if (!bookmarks.Any())
        {
            <div class="slogs-post-list-empty grid min-h-64 place-items-center rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center md:col-span-2">
                <div class="max-w-sm">
                    <p class="text-sm font-semibold text-slate-700">아직 저장 로그 흐름이 없습니다.</p>
                    <p class="mt-2 text-sm leading-6 text-slate-500">공개 흐름에서 다시 이어 읽을 로그를 저장하면 이곳에 모입니다.</p>
                    <div class="mt-4 flex flex-wrap justify-center gap-2">
                        <a class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-slate-800"
                           href="/post">
                            <SlogsIcon Name="search" Class="h-4 w-4" />
                            공개 로그 흐름
                        </a>
                        <a class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                           href="/tag">
                            <SlogsIcon Name="bookmark" Class="h-4 w-4" />
                            단서 회상
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            for (var index = 0; index < bookmarks.Count; index++)
            {
                var post = bookmarks[index];
                <PostLogCard @key="post.Id"
                             Post="post"
                             PostUrl="@GetPostUrl(post)"
                             CommentsUrl="@GetPostCommentsUrl(post)"
                             CurrentUserName="@CurrentUser.UserName"
                             Priority="@IsPriorityCardImage(index)"
                             SummaryMaxLength="140">
                    <ActionContent>
                        <a class="slogs-post-action slogs-post-action--idle inline-flex h-9 min-w-9 items-center justify-center gap-1.5 rounded-full border px-3 text-xs font-semibold transition"
                           href="@GetPostCommentsUrl(post)"
                           aria-label="@($"{post.CommentCount}개 대화 흔적 보기")">
                            <SlogsIcon Name="message-circle" Class="h-4 w-4" />
                            <span>대화 흔적</span>
                            <span class="min-w-4 text-center tabular-nums">@post.CommentCount</span>
                        </a>
                        <button class="rounded-full border border-rose-300 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-50 disabled:cursor-not-allowed disabled:opacity-60"
                                disabled="@(!string.IsNullOrWhiteSpace(pendingRemoveSlug) && pendingRemoveSlug == post.Slug)"
                                type="button" @onclick="() => ToggleBookmark(post.Slug)">
                            @((!string.IsNullOrWhiteSpace(pendingRemoveSlug) && pendingRemoveSlug == post.Slug) ? "해제 중..." : "저장 해제")
                        </button>
                    </ActionContent>
                </PostLogCard>
            }
        }
    </section>

    <InfiniteScrollSentinel Visible="@(bookmarks.Count > 0)"
                            HasMore="@HasMoreBookmarks"
                            IsLoading="@isLoadingMoreBookmarks"
                            OnLoadMore="LoadMoreBookmarksAsync"
                            ShowDoneText="@(allBookmarks.Count > PageSize)"
                            DoneText="모든 저장 로그를 불러왔습니다." />
}

@code {
    private const int PageSize = 6;

    private AuthUser? CurrentUser => AuthState.CurrentUser;
    private IReadOnlyList<BlogPost> bookmarks = Array.Empty<BlogPost>();
    private IReadOnlyList<BlogPost> allBookmarks = Array.Empty<BlogPost>();
    private int totalCount;
    private int totalPages;
    private bool isLoadingMoreBookmarks;
    private string pendingRemoveSlug = string.Empty;
    private string message = string.Empty;
    private string currentStateKey = string.Empty;
    private bool HasMoreBookmarks => bookmarks.Count < allBookmarks.Count;

    [PersistentState]
    public ListPageState<BlogPost>? PrerenderedState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.EnsureInitializedAsync();
        if (CurrentUser is null)
        {

            Navigation.NavigateTo(GetLoginHref());
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await AuthState.EnsureInitializedAsync();
        message = string.Empty;

        if (CurrentUser is null)
        {
            pendingRemoveSlug = string.Empty;
            return;
        }

        currentStateKey = PageStateKeyBuilder.FromNavigation(Navigation);
        if (TryRestorePrerenderedState(currentStateKey))
        {
            return;
        }

        await LoadBookmarksAsync();
        CapturePrerenderedState(currentStateKey);
    }

    private async Task ToggleBookmark(string slug)
    {
        message = string.Empty;

        if (CurrentUser is null)
        {
            message = "로그인이 필요합니다.";
            Navigation.NavigateTo(GetLoginHref());
            return;
        }

        if (!string.IsNullOrWhiteSpace(pendingRemoveSlug))
        {
            return;
        }

        pendingRemoveSlug = slug;
        StateHasChanged();

        try
        {
            var wasBookmarked = bookmarks.Any(x => x.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase));
            var newState = await ApiClient.ToggleBookmarkAsync(slug, CurrentUser.UserName);
            await LoadBookmarksAsync(Math.Max(bookmarks.Count, PageSize));
            CapturePrerenderedState(currentStateKey);

            message = (wasBookmarked && !newState)
                ? "저장 로그에서 제거되었습니다."
                : (!wasBookmarked && newState)
                    ? "저장 로그에 추가되었습니다."
                    : "저장 상태 변경에 실패했습니다.";
        }
        finally
        {
            pendingRemoveSlug = string.Empty;
        }
    }

    private async Task LoadBookmarksAsync(int minimumVisibleCount = PageSize)
    {
        if (CurrentUser is null)
        {
            return;
        }

        allBookmarks = await ApiClient.GetBookmarkedPostsAsync(CurrentUser.UserName);
        totalCount = allBookmarks.Count;
        totalPages = totalCount == 0 ? 0 : (int)Math.Ceiling(totalCount / (double)PageSize);
        bookmarks = allBookmarks.Take(Math.Min(allBookmarks.Count, Math.Max(PageSize, minimumVisibleCount))).ToList();
        isLoadingMoreBookmarks = false;
    }

    private Task LoadMoreBookmarksAsync()
    {
        if (isLoadingMoreBookmarks || !HasMoreBookmarks)
        {
            return Task.CompletedTask;
        }

        isLoadingMoreBookmarks = true;
        try
        {
            bookmarks = allBookmarks.Take(Math.Min(allBookmarks.Count, bookmarks.Count + PageSize)).ToList();
            CapturePrerenderedState(currentStateKey);
        }
        finally
        {
            isLoadingMoreBookmarks = false;
        }

        return Task.CompletedTask;
    }

    private string GetLoginHref()
    {
        var pathWithQuery = GetCurrentPathWithQuery();
        return $"/login?returnUrl={Uri.EscapeDataString(pathWithQuery)}";
    }

    private string GetCurrentPathWithQuery()
    {
        var uri = new Uri(Navigation.Uri);
        return string.IsNullOrWhiteSpace(uri.Query) ? uri.AbsolutePath : uri.PathAndQuery;
    }

    private static string GetPostUrl(BlogPost post)
        => PostNavigationUrlBuilder.BuildPostUrl(post, PostNavigationUrlBuilder.PersonalMenuContext);

    private static string GetPostCommentsUrl(BlogPost post)
        => PostNavigationUrlBuilder.BuildCommentsUrl(post, PostNavigationUrlBuilder.PersonalMenuContext);

    private static bool IsPriorityCardImage(int index) => index < 2;

    private bool TryRestorePrerenderedState(string stateKey)
    {
        if (PrerenderedState?.StateKey != stateKey)
        {
            return false;
        }

        bookmarks = PrerenderedState.Items;
        allBookmarks = PrerenderedState.AllItems;
        totalCount = PrerenderedState.TotalCount;
        totalPages = PrerenderedState.TotalPages;
        message = PrerenderedState.Message ?? string.Empty;
        isLoadingMoreBookmarks = false;
        return true;
    }

    private void CapturePrerenderedState(string stateKey)
    {
        PrerenderedState = new ListPageState<BlogPost>
        {
            StateKey = stateKey,
            Items = bookmarks.ToList(),
            AllItems = allBookmarks.ToList(),
            TotalCount = totalCount,
            TotalPages = totalPages,
            Message = message
        };
    }

}


